msgid "Verify ISO signature"
msgstr "Verificar a assinatura do ISO"

msgid "Manage Trusted Keys"
msgstr "Gerir chaves de confiança"

msgid "Trust this key"
msgstr "Confiar nesta chave"

msgid "Check Another File"
msgstr "Verificar outro ficheiro"

msgid "error: refusing to run as root - run this as your normal desktop user instead"
msgstr "erro: recusa-se a executar como root - execute isto com o seu utilizador normal"

msgid "OK"
msgstr "OK"

msgid "ISO Signature Verifier"
msgstr "Verificador de assinaturas ISO"

msgid "Check the GPG signature of a downloaded ISO (built-in support for MX Linux/antiX signing keys)"
msgstr "Verifica a assinatura GPG de um ISO transferido (suporte integrado para as chaves de assinatura do MX Linux/antiX)"

#, sh-format
msgid "Version ${VERSION}"
msgstr "Versão ${VERSION}"

msgid "Check the GPG signature of a downloaded ISO\\n(built-in support for MX Linux/antiX signing keys)"
msgstr "Verifica a assinatura GPG de um ISO transferido\\n(suporte integrado para as chaves de assinatura do MX Linux/antiX)"

msgid "License: GNU GPL v3 or later"
msgstr "Licença: GNU GPL v3 ou posterior"

#, sh-format
msgid "About ${ABOUT_TITLE}"
msgstr "Acerca de ${ABOUT_TITLE}"

msgid "Close"
msgstr "Fechar"

msgid "Details"
msgstr "Detalhes"

msgid "Untrust"
msgstr "Revogar"

msgid "Import Selected"
msgstr "Importar selecionadas"

msgid "Refresh"
msgstr "Atualizar"

msgid "Could not read the list of trusted keys:"
msgstr "Não foi possível ler a lista de chaves de confiança:"

msgid "No signing keys are currently saved in trustedkeys.gpg."
msgstr "Atualmente não há nenhuma chave de assinatura guardada em trustedkeys.gpg."

#. TRANSLATORS: "Trust"/"Keep" here are informal short references to
#. the main GUI's "Trust this key"/"Keep this key" button labels, not
#. verbatim quotes - no need to match those translated labels exactly.
#. The straight quotes around each word are just English's own
#. convention - please use your language's own quotation marks
#. instead (e.g. « », „", etc.) if that reads more naturally.
msgid "A key ends up there after you choose to \"Trust\"/\"Keep\" it while verifying an ISO."
msgstr "Uma chave acaba lá depois de escolher «Confiar»/«Manter» ao verificar um ISO."

msgid "Import"
msgstr "Importar"

msgid "Select"
msgstr "Selecionar"

msgid "Fingerprint"
msgstr "Impressão digital"

msgid "Key ID"
msgstr "ID da chave"

msgid "User ID"
msgstr "ID do utilizador"

msgid "Status"
msgstr "Estado"

msgid "Expiration Date"
msgstr "Data de expiração"

#. TRANSLATORS: ${BTN_UNTRUST_SELECTED} is the translated button label - keep the placeholder as-is.
#, sh-format
msgid "Keys saved in ~/.gnupg/trustedkeys.gpg - check any you want to untrust, then click \"${BTN_UNTRUST_SELECTED}\"."
msgstr "Chaves guardadas em ~/.gnupg/trustedkeys.gpg - assinale as que quer revogar e clique em \"${BTN_UNTRUST_SELECTED}\"."

msgid "Export"
msgstr "Exportar"

#. TRANSLATORS: shown as-is in the list's "Status" column (a
#. gpg key's trust validity), one word each.
msgid "valid"
msgstr "válida"

#. TRANSLATORS: same "Status" column as "valid" above.
msgid "expired"
msgstr "expirada"

#. TRANSLATORS: same "Status" column as "valid" above.
msgid "revoked"
msgstr "revogada"

#. TRANSLATORS: shown in the "Expires" column when the key has
#. no expiration date set.
msgid "never"
msgstr "nunca"

msgid "No key was checked - nothing to show details for."
msgstr "Não foi assinalada nenhuma chave - nada a mostrar."

#. TRANSLATORS: ${DETAILS_N}/${DETAILS_TOTAL} are literal numbers - keep placeholders as-is.
#, sh-format
msgid "Key ${DETAILS_N} of ${DETAILS_TOTAL}"
msgstr "Chave ${DETAILS_N} de ${DETAILS_TOTAL}"

#, sh-format
msgid "(could not read details: ${OUT})"
msgstr "(não foi possível ler os detalhes: ${OUT})"

msgid "Key Details"
msgstr "Detalhes da chave"

msgid "No key was checked - nothing to export."
msgstr "Não foi assinalada nenhuma chave - nada a exportar."

msgid "Export Trusted Keys"
msgstr "Exportar chaves de confiança"

#, sh-format
msgid "Exported ${EXPORT_COUNT} key(s) to ${EXPORT_PATH_SAFE}."
msgstr "${EXPORT_COUNT} chave(s) exportada(s) para ${EXPORT_PATH_SAFE}."

msgid "Could not export keys:"
msgstr "Não foi possível exportar as chaves:"

#. TRANSLATORS: ${BTN_IMPORT_SELECTED} is the translated button label - keep the placeholder as-is.
msgid "Import Trusted Keys"
msgstr "Importar chaves de confiança"

msgid "OpenPGP key files"
msgstr "Ficheiros de chave OpenPGP"

msgid "All files"
msgstr "Todos os ficheiros"

msgid "Could not read that key file:"
msgstr "Não foi possível ler esse ficheiro de chave:"

msgid "No keys were found in that file."
msgstr "Não foram encontradas chaves nesse ficheiro."

#, sh-format
msgid "Keys found in this file - check any you want to import, then click \"${BTN_IMPORT_SELECTED}\"."
msgstr "Chaves encontradas neste ficheiro - assinale as que deseja importar e depois clique em «${BTN_IMPORT_SELECTED}»."

msgid "Cancel"
msgstr "Cancelar"

#. TRANSLATORS: appended to the Status cell in the
#. import preview when this key is already present in
#. trustedkeys.gpg - lets the user tell "already
#. trusted" apart from "genuinely new" at a glance.
msgid "(already trusted)"
msgstr "(já de confiança)"

msgid "No key was checked - nothing to import."
msgstr "Não foi assinalada nenhuma chave - nada a importar."

#, sh-format
msgid "Processed ${IMPORT_PROCESSED} key(s): ${IMPORT_NEW} new, ${IMPORT_UPDATED} updated, ${IMPORT_UNCHANGED} unchanged."
msgstr "${IMPORT_PROCESSED} chave(s) processada(s): ${IMPORT_NEW} nova(s), ${IMPORT_UPDATED} atualizada(s), ${IMPORT_UNCHANGED} inalterada(s)."

msgid "Could not import keys:"
msgstr "Não foi possível importar as chaves:"

#, sh-format
msgid "Checking ${REFRESH_COUNT} key(s) against pubring.kbx, mx-gpg-keyring, and a keyserver - this can take a while..."
msgstr "A verificar ${REFRESH_COUNT} chave(s) em pubring.kbx, mx-gpg-keyring e num servidor de chaves - isto pode demorar um pouco..."

#, sh-format
msgid "Checking ${REFRESH_COUNT} key(s) against pubring.kbx and a keyserver - this can take a while..."
msgstr "A verificar ${REFRESH_COUNT} chave(s) em pubring.kbx e num servidor de chaves - isto pode demorar um pouco..."

#, sh-format
msgid "Checking ${REFRESH_COUNT} key(s) against mx-gpg-keyring and a keyserver - this can take a while..."
msgstr "A verificar ${REFRESH_COUNT} chave(s) em mx-gpg-keyring e num servidor de chaves - isto pode demorar um pouco..."

#, sh-format
msgid "Checking ${REFRESH_COUNT} key(s) against a keyserver - this can take a while..."
msgstr "A verificar ${REFRESH_COUNT} chave(s) num servidor de chaves - isto pode demorar um pouco..."

#, sh-format
msgid "Checked ${SWEEP_CHECKED} key(s): ${SWEEP_UPDATED} updated, ${SWEEP_REVOKED} revoked."
msgstr "${SWEEP_CHECKED} chave(s) verificada(s): ${SWEEP_UPDATED} atualizada(s), ${SWEEP_REVOKED} revogada(s)."

#, sh-format
msgid "${SWEEP_UNREACHABLE} of ${SWEEP_CHECKED} key(s) could not be checked against any keyserver - results for those may be incomplete."
msgstr "${SWEEP_UNREACHABLE} de ${SWEEP_CHECKED} chave(s) não puderam ser verificadas em nenhum servidor de chaves - os resultados dessas podem estar incompletos."

msgid "Could not refresh trusted keys:"
msgstr "Não foi possível atualizar as chaves de confiança:"

msgid "No key was checked - nothing to untrust."
msgstr "Não foi assinalada nenhuma chave - nada a revogar."

#. TRANSLATORS: ${COUNT} is literal - keep the placeholder as-is.
#, sh-format
msgid "Untrust ${COUNT} selected key(s)?"
msgstr "Revogar ${COUNT} chave(s) selecionada(s)?"

msgid "This tool will stop automatically trusting the selected key(s) - whether they're one of its built-in recognized keys, or separately marked trusted in your own GnuPG keyring. This isn't permanent - trust a key again anytime (verify something signed by it and accept it, or import the key again) and it'll be trusted normally from then on."
msgstr "Esta ferramenta deixará de confiar automaticamente nas chaves selecionadas - seja uma das suas chaves reconhecidas incorporadas, seja uma marcada como fiável separadamente no seu próprio chaveiro GnuPG. Isto não é permanente - volte a confiar numa chave quando quiser (verifique algo assinado por ela e aceite-a, ou importe a chave novamente) e ela passará a ser tratada normalmente como fiável a partir daí."

msgid "Some keys could not be removed:"
msgstr "Algumas chaves não puderam ser removidas:"

#, fuzzy, sh-format
msgid "'${other_title}' is already open - close it first to check this file."
msgstr "Já em execução - feche-o primeiro para verificar este ficheiro."

msgid "Already running - close it first to check this file."
msgstr "Já em execução - feche-o primeiro para verificar este ficheiro."

#, sh-format
msgid "'${other_title}' is already open."
msgstr ""

msgid "Already running."
msgstr "Já em execução."

#, sh-format
msgid "Cannot detect what '${anchor_base}' belongs to:"
msgstr "Não é possível detetar a que pertence '${anchor_base}':"

msgid "Cannot detect how these three files belong together:"
msgstr "Não é possível detetar como estes três ficheiros se relacionam:"

msgid "Cannot detect an ISO, a checksum listing, and its signature among these three files:"
msgstr "Não é possível detetar uma ISO, uma lista de somas de verificação e a sua assinatura entre estes três ficheiros:"

msgid "Too many files were given - at most three are supported."
msgstr "Foram indicados demasiados ficheiros - são suportados no máximo três."

msgid "This tool checks that a downloaded ISO is authentic and undamaged, using its signature file or a signed checksum listing."
msgstr "Esta ferramenta verifica se uma ISO transferida é autêntica e não está danificada, utilizando o seu ficheiro de assinatura ou uma lista de somas de verificação assinada."

msgid "Pick the .iso file, or its .sig/.asc/.gpg/.sign signature file directly."
msgstr "Selecione o ficheiro .iso, ou diretamente o seu ficheiro de assinatura .sig/.asc/.gpg/.sign."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render as
#. bold text, not literal characters).
msgid "The other one is found automatically - <b>but only if it's in the same folder</b>."
msgstr "O outro ficheiro é encontrado automaticamente - <b>mas apenas se estiver na mesma pasta</b>."

msgid "ISO or signature file"
msgstr "Ficheiro ISO ou de assinatura"

msgid "Help"
msgstr "Ajuda"

msgid "About"
msgstr "Acerca"

msgid "Verify"
msgstr "Verificar"

msgid "Or drag a .iso or signature file here"
msgstr "Ou arraste aqui um ficheiro .iso ou de assinatura"

msgid "Pick Files"
msgstr "Selecionar ficheiros"

msgid "Drag a File"
msgstr "Arrastar um ficheiro"

#, sh-format
msgid "Drop at most three files (the ISO plus its checksum listing and/or signature file) - ${DROP_COUNT} were dropped."
msgstr "Largue no máximo três ficheiros (o ISO, a sua lista de somas de verificação e/ou o seu ficheiro de assinatura) - foram largados ${DROP_COUNT}."

msgid "Could not find a way to open a web browser (xdg-open is missing). Open this address yourself:"
msgstr "Não foi possível encontrar uma forma de abrir um navegador web (falta o xdg-open). Abra este endereço você mesmo:"

msgid "That's a folder, not a file - pick the .iso file itself (or its .sig/.asc/.gpg/.sign signature file) directly."
msgstr "Isso é uma pasta, não um ficheiro - selecione diretamente o próprio ficheiro .iso (ou o seu ficheiro de assinatura .sig/.asc/.gpg/.sign)."

#, sh-format
msgid "'${named_base}' looks like a signature file by its name, but its content doesn't look like a real one."
msgstr "'${named_base}' parece um ficheiro de assinatura pelo nome, mas o seu conteúdo não parece real."

#, sh-format
msgid "Neither '${neither_iso_base}' nor '${neither_sig_base}' looks like a real ISO signature file, by name or content."
msgstr "Nem '${neither_iso_base}' nem '${neither_sig_base}' parecem um ficheiro de assinatura ISO real, nem pelo nome nem pelo conteúdo."

#, sh-format
msgid "'${not_plausible_iso_base}' and '${not_plausible_sig_base}' both look like signature or checksum-listing files - pick the actual ISO, plus its checksum listing or signature file."
msgstr "'${not_plausible_iso_base}' e '${not_plausible_sig_base}' parecem ambos um ficheiro de assinatura ou uma lista de somas de verificação - selecione o próprio ISO, além do seu ficheiro de assinatura ou lista de somas de verificação."

msgid "No ISO or signature file was selected."
msgstr "Não foi selecionado nenhum ficheiro ISO nem de assinatura."

msgid "Cannot read ISO file:"
msgstr "Não é possível ler o ficheiro ISO:"

msgid "Cannot find the matching signature file:"
msgstr "Não foi encontrado o ficheiro de assinatura correspondente:"

msgid "Cannot read the checksum-listing file:"
msgstr "Não é possível ler o ficheiro de somas de verificação:"

msgid "ISO:"
msgstr "ISO:"

msgid "SHA:"
msgstr "SHA:"

msgid "About to verify:"
msgstr "A verificar:"

msgid "SIG:"
msgstr "SIG:"

msgid "Verifying signature - this can take a while for a large ISO..."
msgstr "A verificar a assinatura - isto pode demorar algum tempo para um ISO grande..."

msgid "Verifying signature - this can take a few seconds"
msgstr "A verificar a assinatura - isto pode demorar alguns segundos"

#. TRANSLATORS: continues the previous line's sentence ("Verifying
#. signature - this can take a few seconds") onto a second line -
#. the two need to read as one continuous sentence together.
msgid "if the signing key needs to be fetched from a keyserver..."
msgstr "caso seja necessário obter a chave de assinatura a partir de um servidor de chaves..."

msgid "Process was interrupted - the check did not finish, so nothing here has been verified."
msgstr "O processo foi interrompido - a verificação não terminou, por isso nada aqui foi verificado."

msgid "Primary key:"
msgstr "Chave primária:"

#. TRANSLATORS: ${BTN_TRUST_THIS_KEY} is the translated button label - keep the placeholder as-is.
#, sh-format
msgid "By clicking \"${BTN_TRUST_THIS_KEY}\" you confirm you've checked the Key ID or fingerprint yourself and want to trust and remember this key for future checks."
msgstr "Ao clicar em «${BTN_TRUST_THIS_KEY}» confirma que verificou pessoalmente o ID da chave ou a impressão digital, e que deseja confiar nesta chave e recordá-la para futuras verificações."

msgid "You've told this tool not to automatically trust this signing key anymore."
msgstr "Indicou a esta ferramenta para não confiar mais automaticamente nesta chave de assinatura."

msgid "You've told this tool not to automatically trust this checksum-listing signing key anymore."
msgstr "Indicou a esta ferramenta para não confiar mais automaticamente na chave de assinatura desta lista de somas de verificação."

msgid "This ISO's signing key isn't one this tool already recognizes."
msgstr "A chave de assinatura deste ISO não é uma que esta ferramenta já reconheça."

msgid "This checksum-listing file's signing key isn't one this tool already recognizes."
msgstr "A chave de assinatura deste ficheiro de lista de somas de verificação não é uma que esta ferramenta já reconheça."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
msgid "Signature check: <b>GOOD</b> - the ISO exactly matches this key."
msgstr "Verificação da assinatura: <b>BOA</b> - o ISO corresponde exatamente a esta chave."

msgid "Note: that identity is just self-declared text - whoever made the key could have typed anything there. The Key ID and fingerprint are different: they can't be faked, so they're what you can actually check against an independent source. Only trust this key if you've confirmed the Key ID or fingerprint yourself (e.g. from the respin/distro's own official site, or its keyserver listing)."
msgstr "Nota: Essa identidade é apenas texto autodeclarado - quem criou a chave poderia ter colocado ali o que quisesse. O ID da chave e a impressão digital são diferentes: não podem ser falsificados, por isso são o que pode realmente verificar junto de uma fonte independente. Só confie nesta chave se tiver confirmado pessoalmente o ID da chave ou a impressão digital (por exemplo, no site oficial do respin/distribuição, ou num servidor de chaves)."

msgid "Key ID:"
msgstr "ID da chave:"

msgid "Claimed identity:"
msgstr "Identidade declarada:"

msgid "Fingerprint:"
msgstr "Impressão digital:"

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
msgid "Signature check: <b>GOOD</b> - the checksum listing exactly matches this key (the ISO's own hash is checked separately, next)."
msgstr "Verificação da assinatura: <b>BOA</b> - a lista de somas de verificação corresponde exatamente a esta chave (o próprio hash do ISO é verificado separadamente, a seguir)."

msgid "Note: that identity is just self-declared text - whoever made the key could have typed anything there. The Key ID and fingerprint are different: they can't be faked, so they're what you can actually check against an independent source. Only trust this key if you've confirmed it yourself (e.g. from the distro's own official website or keyserver listing)."
msgstr "Nota: Essa identidade é apenas texto autodeclarado - quem criou a chave poderia ter colocado ali o que quisesse. O ID da chave e a impressão digital são diferentes: não podem ser falsificados, por isso são o que pode realmente verificar junto de uma fonte independente. Só confie nesta chave se a tiver confirmado pessoalmente (por exemplo, no site oficial da distribuição ou num servidor de chaves)."

msgid "This signing key currently only lives in your personal keyring (pubring.kbx)."
msgstr "Esta chave de assinatura atualmente só existe no seu chaveiro pessoal (pubring.kbx)."

msgid "Copy it into ~/.gnupg/trustedkeys.gpg so future checks don't depend on it staying there?"
msgstr "Copiá-la para ~/.gnupg/trustedkeys.gpg para que as futuras verificações não dependam de ela lá permanecer?"

msgid "This signing key was just fetched from a keyserver."
msgstr "Esta chave de assinatura acabou de ser obtida a partir de um servidor de chaves."

msgid "Remember it locally, in ~/.gnupg/trustedkeys.gpg, so future checks don't need the network again?"
msgstr "Guardá-la localmente, em ~/.gnupg/trustedkeys.gpg, para que as futuras verificações não precisem novamente da rede?"

msgid "Keep this key"
msgstr "Manter esta chave"

msgid "No thanks"
msgstr "Não, obrigado"

msgid "key fetched and saved locally - future checks won't need the network"
msgstr "chave obtida e guardada localmente - as futuras verificações não precisarão da rede"

msgid "used an already-cached key, no network needed"
msgstr "utilizada uma chave já em cache, sem necessidade de rede"

msgid "used a key from your personal keyring (pubring.kbx)"
msgstr "utilizada uma chave do seu chaveiro pessoal (pubring.kbx)"

msgid "used a key from mx-gpg-keyring"
msgstr "utilizada uma chave de mx-gpg-keyring"

msgid "key saved locally for faster future checks"
msgstr "chave guardada localmente para verificações futuras mais rápidas"

msgid "fetched the signing key from a keyserver"
msgstr "obtida a chave de assinatura a partir de um servidor de chaves"

#. TRANSLATORS: ${KEY_EXPIRY_DATE_SAFE} is a date (e.g. 2026-08-06) - keep the placeholder as-is.
#, sh-format
msgid "this key expired on ${KEY_EXPIRY_DATE_SAFE} - this does not affect the signature check"
msgstr "esta chave expirou em ${KEY_EXPIRY_DATE_SAFE} - isto não afeta a verificação da assinatura"

msgid "this key has expired - this does not affect the signature check"
msgstr "esta chave expirou - isto não afeta a verificação da assinatura"

msgid "Verified OK"
msgstr "Verificação bem-sucedida"

msgid "Key not trusted"
msgstr "Chave não fidedigna"

msgid "Nothing to verify"
msgstr "Nada para verificar"

msgid "Verification FAILED"
msgstr "Verificação FALHADA"

msgid "This signing key has been revoked - refusing to use it, whatever the reason (a real key compromise, or the owner deliberately retiring it). Do not trust this file."
msgstr "Esta chave de assinatura foi revogada - não será utilizada, seja qual for o motivo (um comprometimento real da chave, ou a sua retirada deliberada pelo proprietário). Não confie neste ficheiro."

msgid "The signing key could not be fetched from any keyserver - this looks like a network problem, not necessarily a bad signature. Try again once you have a working connection."
msgstr "Não foi possível obter a chave de assinatura de nenhum servidor de chaves - isto parece um problema de rede, não necessariamente uma assinatura inválida. Tente novamente quando tiver ligação."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE}/${BTN_TRUST_THIS_KEY} are translated button labels - keep placeholders as-is.
#, sh-format
msgid "The cryptographic check itself already came back GOOD (see the technical details below) - you just haven't trusted this signing key yet. If you're confident this is the genuine key (e.g. you've checked its fingerprint against the distro's own official site or keyserver listing), click \"${BTN_CHECK_ANOTHER_FILE}\" and choose \"${BTN_TRUST_THIS_KEY}\" this time."
msgstr "A própria verificação criptográfica já tinha sido BOA (veja os detalhes técnicos abaixo) - simplesmente ainda não confiou nesta chave de assinatura. Se tiver a certeza de que é a chave genuína (por exemplo, verificou a sua impressão digital no sítio oficial da distribuição ou num servidor de chaves), clique em «${BTN_CHECK_ANOTHER_FILE}» e escolha desta vez «${BTN_TRUST_THIS_KEY}»."

msgid "The cryptographic check itself already came back GOOD (see the technical details below) - the key just couldn't be saved for future trust (see the technical details for why). Feel free to try again."
msgstr "A própria verificação criptográfica já tinha sido BOA (veja os detalhes técnicos abaixo) - a chave apenas não pôde ser guardada para confiança futura (veja os detalhes técnicos para saber porquê). Sinta-se à vontade para tentar novamente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid "You pointed this tool at a checksum-listing file, not a single ISO - it can cover many ISOs at once, so there's no one file to check unless exactly one of the ones it mentions is actually present here (see the technical details below for which). Use \"${BTN_CHECK_ANOTHER_FILE}\" and point at the actual .iso file instead."
msgstr "Apontou esta ferramenta para um ficheiro de lista de somas de verificação, não para um único ISO - esse ficheiro pode cobrir vários ISO ao mesmo tempo, pelo que não há um único ficheiro a verificar, a menos que exatamente um dos que menciona esteja realmente presente aqui (veja os detalhes técnicos abaixo para saber qual). Utilize «${BTN_CHECK_ANOTHER_FILE}» e aponte diretamente para o ficheiro .iso real."

msgid "No signature file or signed checksum listing was found for this ISO - there's nothing here to check yet."
msgstr "Não foi encontrado nenhum ficheiro de assinatura nem nenhuma lista de somas de verificação assinada para esta ISO - ainda não há nada para verificar aqui."

#. TRANSLATORS: ${CHECKSUM_FILE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid "This checksum listing (${CHECKSUM_FILE_SAFE}) has no signature file of its own (.sig/.asc/.gpg/.sign) next to it - it can't be trusted without one, so it was never checked against this ISO."
msgstr "Esta lista de somas de verificação (${CHECKSUM_FILE_SAFE}) não tem um ficheiro de assinatura próprio (.sig/.asc/.gpg/.sign) ao seu lado - sem ele não é possível confiar nela, por isso nunca foi verificada em relação a esta ISO."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#, sh-format
msgid "This is a signature file, but its ISO ('${DISPLAY_ISO_SAFE}') isn't in the same folder - this tool only looks for a counterpart next to the file you pick."
msgstr "Este é um ficheiro de assinatura, mas a sua ISO ('${DISPLAY_ISO_SAFE}') não está na mesma pasta - esta ferramenta só procura o correspondente ao lado do ficheiro que escolher."

#. TRANSLATORS: ${LISTING_BASE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid "This is a signature file for a checksum listing, but '${LISTING_BASE_SAFE}' isn't in the same folder - this tool only looks for a counterpart next to the file you pick."
msgstr "Este é um ficheiro de assinatura de uma lista de somas de verificação, mas '${LISTING_BASE_SAFE}' não está na mesma pasta - esta ferramenta só procura o correspondente ao lado do ficheiro que escolher."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#, sh-format
msgid "Neither '${DISPLAY_ISO_SAFE}' nor a signature file for it were found in this folder - nothing to check yet."
msgstr "Não foi encontrado nem o ficheiro '${DISPLAY_ISO_SAFE}' nem um ficheiro de assinatura para ele nesta pasta - ainda não há nada para verificar."

msgid "This checksum file isn't signed, and the ISO it describes has no signature of its own either - there's nothing here this tool can cryptographically verify. Check whether the distro provides a signed checksum listing, a direct .sig/.asc/.gpg file, or a self-contained clearsigned checksum (e.g. '.sha512.asc') for this ISO."
msgstr "Este ficheiro de somas de verificação não está assinado, e o ISO que descreve também não tem assinatura própria - não há aqui nada que esta ferramenta possa verificar criptograficamente. Verifique se a distribuição fornece uma lista de somas de verificação assinada, um ficheiro .sig/.asc/.gpg direto, ou uma soma de verificação autoassinada e autónoma (por ex. '.sha512.asc') para este ISO."

msgid "The checksum listing's signing key could not be fetched from any keyserver - nothing in it could be checked. This looks like a network problem, not necessarily a bad signature. Try again once you have a working connection."
msgstr "Não foi possível obter a chave de assinatura da lista de somas de verificação de nenhum servidor de chaves - nada nela pôde ser verificado. Isto parece um problema de rede, não necessariamente uma assinatura inválida. Tente novamente quando tiver ligação."

msgid "The checksum file that lists this ISO's hash failed its own verification (bad/untrusted signature, or its key couldn't be confirmed) - nothing in it can be trusted. Re-download the checksum/signature files (and probably the ISO too), ideally from a different mirror."
msgstr "O ficheiro de somas de verificação que lista o hash deste ISO falhou a sua própria verificação (assinatura inválida/não fiável, ou não foi possível confirmar a sua chave) - nada nele é de confiança. Volte a transferir os ficheiros de soma de verificação/assinatura (e provavelmente também o ISO), de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${CHECKSUM_INFO_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid "This ISO was checked against a signed checksum listing (${CHECKSUM_INFO_SAFE}) that IS validly signed - but the ISO's own hash doesn't match what's listed. The checksum list itself is trustworthy; this particular download is not. Re-download the ISO, ideally from a different mirror."
msgstr "Este ISO foi verificado com base numa lista de somas de verificação assinada (${CHECKSUM_INFO_SAFE}) que ESTÁ validamente assinada - mas o próprio hash do ISO não corresponde ao que está listado. A lista de somas de verificação em si é de confiança; esta transferência em particular não é. Volte a transferir o ISO, de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid "No direct signature file was found for this ISO, and none of the checksum-listing files found nearby mention this exact ISO filename either. If this distro uses a different naming convention, use \"${BTN_CHECK_ANOTHER_FILE}\" and point at the right file directly."
msgstr "Não foi encontrado nenhum ficheiro de assinatura direto para este ISO, e nenhum dos ficheiros de lista de somas de verificação encontrados nas proximidades menciona também este nome exato de ficheiro ISO. Se esta distribuição utilizar uma convenção de nomenclatura diferente, utilize «${BTN_CHECK_ANOTHER_FILE}» e aponte diretamente para o ficheiro correto."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid "This signature file's name doesn't match this ISO's name, so it likely belongs to a different download. Use \"${BTN_CHECK_ANOTHER_FILE}\" and pick just this ISO, or just its own real signature file - the tool finds the matching one automatically."
msgstr "O nome deste ficheiro de assinatura não corresponde ao nome desta ISO, pelo que provavelmente pertence a uma transferência diferente. Utilize «${BTN_CHECK_ANOTHER_FILE}» e escolha apenas esta ISO, ou apenas o seu próprio ficheiro de assinatura real - a ferramenta encontra automaticamente o ficheiro correspondente."

msgid "On top of the signature not matching, this signing key also isn't one this tool already recognizes - treat this file as untrustworthy and re-download from an official source."
msgstr "Além de a assinatura não corresponder, esta chave de assinatura também não é uma que esta ferramenta já reconheça - trate este ficheiro como não fiável e volte a transferi-lo a partir de uma fonte oficial."

msgid "The ISO may be corrupted, or the download was incomplete or tampered with - try re-downloading it, ideally from a different mirror."
msgstr "O ISO pode estar corrompido, ou a transferência ficou incompleta ou foi adulterada - tente transferi-lo novamente, de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${WEAK_ALGO_SAFE} is a literal algorithm name (e.g. "md5") - keep the placeholder as-is.
#, sh-format
msgid "This relies on ${WEAK_ALGO_SAFE}, a broken checksum algorithm - a matching hash doesn't prove the ISO is genuine. Prefer a real signature or a stronger checksum (SHA256/SHA512) when available."
msgstr "Isto baseia-se em ${WEAK_ALGO_SAFE}, um algoritmo de soma de verificação comprometido - uma soma correspondente não prova que a ISO é genuína. Prefira uma assinatura real ou uma soma de verificação mais forte (SHA256/SHA512) quando disponível."

#, sh-format
msgid "${algo} is a broken checksum algorithm - a matching hash doesn't prove the ISO is genuine. Prefer a real signature or a stronger checksum (SHA256/SHA512) when available."
msgstr "${algo} é um algoritmo de soma de verificação comprometido - uma soma correspondente não prova que a ISO é genuína. Prefira uma assinatura real ou uma soma de verificação mais forte (SHA256/SHA512) quando disponível."

msgid "Usage:"
msgstr "Utilização:"

#. TRANSLATORS: keep the distro names (Debian, Ubuntu, Linux Mint) exactly as-is.
msgid "Verify the GPG signature of an ISO image (any distro - built-in recognition of the documented MX Linux/antiX signing keys, plus a checksum-listing convention for distros that sign a checksum listing instead of the ISO directly, e.g. Debian, Ubuntu, Linux Mint)."
msgstr "Verifica a assinatura GPG de uma imagem ISO (qualquer distribuição - com reconhecimento integrado das chaves de assinatura documentadas do MX Linux/antiX, bem como uma convenção de lista de somas de verificação para distribuições que assinam uma lista de somas de verificação em vez do próprio ISO, por exemplo, Debian, Ubuntu, Linux Mint)."

msgid "this help"
msgstr "esta ajuda"

msgid "show version and exit"
msgstr "mostra a versão e sai"

msgid "full manual: every option, recognition rules, the checksum-listing convention, and more"
msgstr "manual completo: todas as opções, regras de reconhecimento, a convenção de lista de somas de verificação e mais"

msgid "verify once even if the key isn't recognized"
msgstr "verifica uma vez mesmo que a chave não seja reconhecida"

#. TRANSLATORS: ${FLAG_ALLOW_UNKNOWN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "like ${FLAG_ALLOW_UNKNOWN}, and remembers the key too"
msgstr "como ${FLAG_ALLOW_UNKNOWN}, mas também memoriza a chave"

msgid "list this tool's built-in recognized signing keys"
msgstr "listar as chaves de assinatura incorporadas que esta ferramenta reconhece"

msgid "list every key saved in trustedkeys.gpg"
msgstr "lista todas as chaves guardadas em trustedkeys.gpg"

msgid "Run with no arguments, or via a file manager's \"Open With\" (up to 3 files), to open a picker window instead."
msgstr "Executado sem argumentos, ou através de 'Abrir com' num gestor de ficheiros (até 3 ficheiros), isto abre uma janela de seleção em alternativa."

#. TRANSLATORS: ${FLAG_MAN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "For every other option (scripting/automation flags) see ${FLAG_MAN}."
msgstr "Para qualquer outra opção (opções de script/automação) consulte ${FLAG_MAN}."

msgid "could not generate the man page (pandoc failed)"
msgstr "não foi possível gerar a página do manual (o pandoc falhou)"

#. TRANSLATORS: ${man_src} is a file path, ${FLAG_MAN} a literal flag name.
#, sh-format
msgid "man page not built yet and pandoc isn't installed - see ${man_src} directly, or install pandoc and re-run ${FLAG_MAN}"
msgstr "a página do manual ainda não foi gerada e o pandoc não está instalado - consulte diretamente ${man_src}, ou instale o pandoc e execute novamente ${FLAG_MAN}"

msgid "warning:"
msgstr "aviso:"

msgid "info:"
msgstr "info:"

msgid "error:"
msgstr "erro:"

#. TRANSLATORS: ${flag}/${FLAG_MAN} are literal names - keep placeholders as-is.
#, sh-format
msgid "${flag} requires a value (see ${FLAG_MAN})"
msgstr "${flag} requer um valor (consulte ${FLAG_MAN})"

msgid "Manage trusted keys from the command line:"
msgstr "Faça a gestão das chaves de confiança a partir da linha de comandos:"

#. TRANSLATORS: ${ENV_DISPLAY}/${ENV_WAYLAND_DISPLAY} are literal env-var names - keep placeholders as-is.
#, sh-format
msgid "no graphical session detected (neither ${ENV_DISPLAY} nor ${ENV_WAYLAND_DISPLAY} is set) - the trusted-keys manager needs a desktop to show its window."
msgstr "nenhuma sessão gráfica detetada (nem ${ENV_DISPLAY} nem ${ENV_WAYLAND_DISPLAY} está definida) - o gestor de chaves de confiança precisa de um ambiente gráfico para mostrar a sua janela."

msgid "Manage trusted keys from the command line instead:"
msgstr "Faça a gestão das chaves de confiança a partir da linha de comandos:"

msgid "list key(s) saved in trustedkeys.gpg (all if none given)"
msgstr "lista a(s) chave(s) guardada(s) em trustedkeys.gpg (todas se nenhuma for indicada)"

msgid "check every trusted key against pubring.kbx, mx-gpg-keyring, and a keyserver for updates (renewed expiry, new subkeys, or a revocation)"
msgstr "verificar cada chave de confiança em pubring.kbx, mx-gpg-keyring e num servidor de chaves à procura de atualizações (validade renovada, novas subchaves ou uma revogação)"

msgid "show fingerprint/algorithm/dates/subkeys for trusted key(s)"
msgstr "mostrar impressão digital/algoritmo/datas/subchaves das chaves de confiança"

msgid "remove <fpr> from trustedkeys.gpg"
msgstr "remove <fpr> de trustedkeys.gpg"

msgid "export trusted key(s) to <path> (all if none given)"
msgstr "exporta a(s) chave(s) de confiança para <path> (todas se nenhuma for indicada)"

msgid "list the key(s) in an external key file, read-only"
msgstr "lista a(s) chave(s) num ficheiro de chave externo, apenas leitura"

msgid "import key(s) from an external key file (all if none given)"
msgstr "importa chave(s) de um ficheiro de chave externo (todas se nenhuma for indicada)"

#. TRANSLATORS: ${CMD_MAN} is a literal command - keep the placeholder as-is.
#, sh-format
msgid "See '${CMD_MAN}' for the full manual."
msgstr "Consulte '${CMD_MAN}' para o manual completo."

#. TRANSLATORS: ${FLAG_MAN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "verify-iso-sig - opens a window to pick and check an ISO or signature file by default when a graphical session is available; falls back to the plain command-line tool otherwise. This preamble covers this launcher's own behavior; a short command-line reference (used automatically whenever given arguments don't look like that window's own syntax, or no graphical session is available) follows below it - see ${FLAG_MAN} for the complete one."
msgstr "verify-iso-sig abre por predefinição uma janela para escolher e verificar um ficheiro ISO ou de assinatura quando existe uma sessão gráfica disponível; caso contrário, recorre à ferramenta de linha de comandos. Esta introdução cobre o comportamento deste lançador; segue-se uma breve referência de linha de comandos (usada automaticamente sempre que os argumentos indicados não se pareçam com a sintaxe dessa janela, ou não exista sessão gráfica disponível) - consulte ${FLAG_MAN} para a referência completa."

msgid "open that window if a display is available (default), otherwise this same help"
msgstr "abre essa janela se existir um ecrã disponível (predefinição), caso contrário esta mesma ajuda"

msgid "(default) the graphical main program"
msgstr "(predefinição) o programa gráfico principal"

msgid "plain command-line mode"
msgstr "modo de linha de comandos"

#. TRANSLATORS: ${FLAG_HELP} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "trusted-keys manager GUI (add ${FLAG_HELP} for its own flags), or with no display, print the CLI flags that cover the same ground"
msgstr "interface gráfica do gestor de chaves de confiança (adicione ${FLAG_HELP} para as suas próprias opções), ou sem ecrã, imprime as opções da CLI que cobrem o mesmo"

#. TRANSLATORS: ${FLAG_GUI} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "same as ${FLAG_GUI}, but also shows the drag-and-drop pane (most users won't need this - reachable from the app menu's own \"Drag & Drop\" entry)"
msgstr "igual a ${FLAG_GUI}, mas também mostra o painel de arrastar e soltar (a maioria dos utilizadores não precisa disto - acessível a partir da entrada «Arrastar e Soltar» do menu da aplicação)"

#. TRANSLATORS: ${FLAG_CHECKSUM_ALGO}/${algo} are literal - keep placeholders as-is.
#, sh-format
msgid "unknown ${FLAG_CHECKSUM_ALGO} '${algo}' (expected sha256, sha512, sha1, or md5)"
msgstr "${FLAG_CHECKSUM_ALGO} '${algo}' desconhecido (esperado sha256, sha512, sha1, ou md5)"

#. TRANSLATORS: ${opt}/${FLAG_MAN} are literal - keep placeholders as-is.
#, sh-format
msgid "unknown option '${opt}' (see ${FLAG_MAN})"
msgstr "opção '${opt}' desconhecida (consulte ${FLAG_MAN})"

#. TRANSLATORS: ${FLAG_KEEP_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "exactly one fingerprint argument is required for ${FLAG_KEEP_KEY}"
msgstr "é necessário exatamente um argumento de impressão digital para ${FLAG_KEEP_KEY}"

#. TRANSLATORS: ${FLAG_KEEP_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "${FLAG_KEEP_KEY} needs a full 40-character (or 64-character) hex fingerprint, not '${FPR}'"
msgstr "${FLAG_KEEP_KEY} exige uma impressão digital hexadecimal completa de 40 caracteres (ou 64 caracteres), não '${FPR}'"

#. TRANSLATORS: ${FLAG_SHOW_KEY_DETAILS} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "at least one fingerprint argument is required for ${FLAG_SHOW_KEY_DETAILS}"
msgstr "${FLAG_SHOW_KEY_DETAILS} exige pelo menos um argumento de impressão digital"

#. TRANSLATORS: ${FLAG_SHOW_KEY_DETAILS} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "${FLAG_SHOW_KEY_DETAILS} needs a full 40-character (or 64-character) hex fingerprint, not '${fpr}'"
msgstr "${FLAG_SHOW_KEY_DETAILS} exige uma impressão digital hexadecimal completa de 40 caracteres (ou 64 caracteres), não '${fpr}'"

msgid "this option takes no extra arguments"
msgstr "esta opção não aceita argumentos adicionais"

msgid "expected an ISO or signature file to check"
msgstr "esperava-se um ficheiro ISO ou de assinatura para verificar"

#, sh-format
msgid "cannot detect what '${anchor_base}' belongs to: '${cand1_base}', '${cand2_base}'."
msgstr "não é possível detetar a que pertence '${anchor_base}': '${cand1_base}', '${cand2_base}'."

#, sh-format
msgid "cannot detect how these three files belong together: '${triple_base1}', '${triple_base2}', '${triple_base3}'."
msgstr "não é possível detetar como estes três ficheiros se relacionam: '${triple_base1}', '${triple_base2}', '${triple_base3}'."

#, sh-format
msgid "cannot detect an ISO, a checksum listing, and its signature among these three files: '${triple_base1}', '${triple_base2}', '${triple_base3}'."
msgstr "não é possível detetar uma ISO, uma lista de somas de verificação e a sua assinatura entre estes três ficheiros: '${triple_base1}', '${triple_base2}', '${triple_base3}'."

#, sh-format
msgid "'${ISO}' is a directory, not a file - point this at the actual .iso file (or its .sig/.asc/.gpg/.sign signature file) directly."
msgstr "'${ISO}' é uma pasta, não um ficheiro - aponte diretamente para o ficheiro .iso real (ou para o seu ficheiro de assinatura .sig/.asc/.gpg/.sign)."

#, sh-format
msgid "'${named_base}' looks like a signature file by its name, but its content doesn't look like a real one - point this tool at the actual signature file, or a checksum listing."
msgstr "'${named_base}' parece um ficheiro de assinatura pelo nome, mas o seu conteúdo não parece real - aponte esta ferramenta para o ficheiro de assinatura real, ou para uma lista de somas de verificação."

#, sh-format
msgid "neither '${iso_base}' nor '${sig_base}' looks like a real ISO signature file, by name or content - point this tool at the actual ISO and its .sig/.asc/.gpg/.sign file, or a checksum listing."
msgstr "nem '${iso_base}' nem '${sig_base}' parecem um ficheiro de assinatura ISO real, nem pelo nome nem pelo conteúdo - aponte esta ferramenta para a própria ISO e para o seu ficheiro .sig/.asc/.gpg/.sign, ou para uma lista de somas de verificação."

#, sh-format
msgid "'${iso_base}' and '${sig_base}' both look like signature or checksum-listing files - point this tool at the actual ISO, plus its checksum listing or signature file."
msgstr "'${iso_base}' e '${sig_base}' parecem ambos um ficheiro de assinatura ou uma lista de somas de verificação - aponte esta ferramenta para o próprio ISO, além do seu ficheiro de assinatura ou lista de somas de verificação."

#, sh-format
msgid "'${SIG}' is a directory, not a file - point this at the actual signature file directly."
msgstr "'${SIG}' é uma pasta, não um ficheiro - aponte diretamente para o ficheiro de assinatura real."

#, sh-format
msgid "warning: could not read ${MX_GPG_KEYRING}: ${out}"
msgstr "aviso: não foi possível ler ${MX_GPG_KEYRING}: ${out}"

#, sh-format
msgid "this key expired on ${date_str} - this does not affect the signature check"
msgstr "esta chave expirou em ${date_str} - isto não afeta a verificação da assinatura"

msgid "this signing key has been revoked - refusing to use it, whatever the reason (a real key compromise, or the owner deliberately retiring it)"
msgstr "esta chave de assinatura foi revogada - não será utilizada, seja qual for o motivo (um comprometimento real da chave, ou a sua retirada deliberada pelo proprietário)"

msgid "this key was found revoked locally - updated the local copy automatically"
msgstr "esta chave foi encontrada revogada localmente - cópia local atualizada automaticamente"

msgid "this key's expiry was renewed - updated local copy automatically"
msgstr "a validade desta chave foi renovada - cópia local atualizada automaticamente"

#, sh-format
msgid "checking ${ks} for a renewed copy of this key..."
msgstr "a verificar ${ks} em busca de uma cópia renovada desta chave..."

#, sh-format
msgid "${ks} reports this key as revoked - updated the local copy automatically"
msgstr "o ${ks} indica que esta chave está revogada - cópia local atualizada automaticamente"

msgid "no renewal found - continuing with the existing (expired) key"
msgstr "não foi encontrada nenhuma renovação - a continuar com a chave existente (expirada)"

#, sh-format
msgid "warning: fingerprint '${fpr}' not found in ${TRUSTED_GPG}, skipping"
msgstr "aviso: impressão digital '${fpr}' não encontrada em ${TRUSTED_GPG}, a ignorar"

#, sh-format
msgid "note: '${fpr}' is a subkey - resolved to its primary key '${resolved}'"
msgstr "nota: '${fpr}' é uma subchave - resolvida para a sua chave primária '${resolved}'"

#, sh-format
msgid "no trusted keys saved yet (${TRUSTED_GPG} doesn't exist)"
msgstr "ainda não há chaves de confiança guardadas (${TRUSTED_GPG} não existe)"

#, sh-format
msgid "${fpr} (${uid}) is revoked - updated ${TRUSTED_GPG}"
msgstr "${fpr} (${uid}) está revogada - ${TRUSTED_GPG} atualizado"

#, sh-format
msgid "${fpr} (${uid}) has newer key data - updated ${TRUSTED_GPG}"
msgstr "${fpr} (${uid}) tem dados de chave mais recentes - ${TRUSTED_GPG} atualizado"

#, sh-format
msgid "checked ${checked} key(s): ${updated} updated, ${revoked_found} revoked"
msgstr "${checked} chave(s) verificada(s): ${updated} atualizada(s), ${revoked_found} revogada(s)"

#, sh-format
msgid "${unreachable} of ${checked} key(s) could not be checked against any keyserver - results for those may be incomplete"
msgstr "${unreachable} de ${checked} chave(s) não puderam ser verificadas em nenhum servidor de chaves - os resultados dessas podem estar incompletos"

#, sh-format
msgid "warning: could not read details for '${fpr}': ${out}"
msgstr "aviso: não foi possível ler os detalhes de '${fpr}': ${out}"

#, sh-format
msgid "removed ${UNTRUST_KEY} from ${TRUSTED_GPG}"
msgstr "removida ${UNTRUST_KEY} de ${TRUSTED_GPG}"

#, sh-format
msgid "could not remove '${UNTRUST_KEY}' from ${TRUSTED_GPG}: ${out}"
msgstr "não foi possível remover '${UNTRUST_KEY}' de ${TRUSTED_GPG}: ${out}"

msgid "no matching trusted key(s) to export"
msgstr "nenhuma chave de confiança correspondente para exportar"

#, sh-format
msgid "could not export to '${EXPORT_TRUSTED_KEYS}': ${ERR}"
msgstr "não foi possível exportar para '${EXPORT_TRUSTED_KEYS}': ${ERR}"

#, sh-format
msgid "exported ${EXPORTED_COUNT} key(s) to ${EXPORT_TRUSTED_KEYS}"
msgstr "${EXPORTED_COUNT} chave(s) exportada(s) para ${EXPORT_TRUSTED_KEYS}"

#, sh-format
msgid "cannot read '${INSPECT_KEY_FILE}'"
msgstr "não é possível ler '${INSPECT_KEY_FILE}'"

#, sh-format
msgid "'${INSPECT_KEY_FILE}' does not look like a valid OpenPGP key file: ${SHOW_OUT}"
msgstr "'${INSPECT_KEY_FILE}' não parece ser um ficheiro de chave OpenPGP válido: ${SHOW_OUT}"

#, sh-format
msgid "'${INSPECT_KEY_FILE}' contains private/secret key material - refusing to treat it as a public trusted-signing key"
msgstr "'${INSPECT_KEY_FILE}' contém material de chave privada/secreta - a recusar tratá-lo como uma chave pública de assinatura de confiança"

#, sh-format
msgid "${fpr} removed from the explicitly-untrusted list - it can be auto-recognized again"
msgstr "${fpr} foi removida da lista de chaves explicitamente não fiáveis - pode voltar a ser reconhecida automaticamente"

#, sh-format
msgid "warning: could not export key from ${ring}: ${out}"
msgstr "aviso: não foi possível exportar a chave de ${ring}: ${out}"

#, sh-format
msgid "cannot read '${IMPORT_TRUSTED_KEYS}'"
msgstr "não é possível ler '${IMPORT_TRUSTED_KEYS}'"

#, sh-format
msgid "'${IMPORT_TRUSTED_KEYS}' does not look like a valid OpenPGP key file: ${SHOW_OUT}"
msgstr "'${IMPORT_TRUSTED_KEYS}' não parece ser um ficheiro de chave OpenPGP válido: ${SHOW_OUT}"

#, sh-format
msgid "'${IMPORT_TRUSTED_KEYS}' contains private/secret key material - refusing to import it as a public trusted-signing key"
msgstr "'${IMPORT_TRUSTED_KEYS}' contém material de chave privada/secreta - a recusar importá-lo como uma chave pública de assinatura de confiança"

#, sh-format
msgid "no OpenPGP keys found in '${IMPORT_TRUSTED_KEYS}'"
msgstr "não foram encontradas chaves OpenPGP em '${IMPORT_TRUSTED_KEYS}'"

#, sh-format
msgid "could not import '${IMPORT_TRUSTED_KEYS}' into a scratch keyring"
msgstr "não foi possível importar '${IMPORT_TRUSTED_KEYS}' para um chaveiro temporário"

#, sh-format
msgid "warning: fingerprint '${fpr}' not found in '${IMPORT_TRUSTED_KEYS}', skipping"
msgstr "aviso: impressão digital '${fpr}' não encontrada em '${IMPORT_TRUSTED_KEYS}', a ignorar"

msgid "no matching key(s) to import"
msgstr "nenhuma chave correspondente para importar"

#, sh-format
msgid "warning: could not import '${FPR}' into ${TRUSTED_GPG}"
msgstr "aviso: não foi possível importar '${FPR}' para ${TRUSTED_GPG}"

#, sh-format
msgid "no key(s) were actually imported into ${TRUSTED_GPG}"
msgstr "nenhuma chave foi efetivamente importada para ${TRUSTED_GPG}"

#. TRANSLATORS: this exact line is also parsed by the GUI's own
#. --status-fd tag right after it (IMPORT_SUMMARY, never localized) -
#. translate freely, the numbers/word order can differ per language,
#. only this line's own display text changes.
#, sh-format
msgid "${PROCESSED} key(s) processed: ${IMPORTED} new, ${CHANGED} updated, ${UNCHANGED_COUNT} unchanged"
msgstr "${PROCESSED} chave(s) processada(s): ${IMPORTED} nova(s), ${CHANGED} atualizada(s), ${UNCHANGED_COUNT} inalterada(s)"

#, sh-format
msgid "neither '${candidate_base}' nor a signature file for it were found in this folder - nothing to check yet."
msgstr "não foi encontrado nem o ficheiro '${candidate_base}' nem um ficheiro de assinatura para ele nesta pasta - ainda não há nada para verificar."

#, sh-format
msgid "'${iso_base}' names multiple files present in this folder: ${candidates_joined} - point this tool at the specific .iso file you want to check instead."
msgstr "'${iso_base}' menciona vários ficheiros presentes nesta pasta: ${candidates_joined} - aponte esta ferramenta diretamente para o ficheiro .iso específico que deseja verificar."

#, sh-format
msgid "resolved ISO: ${resolved_base}"
msgstr "ISO resolvido: ${resolved_base}"

#, sh-format
msgid "'${iso_base}' is unsigned - not used for verification. Using '${clearsigned_base}' instead, a self-contained clearsigned checksum for the ISO."
msgstr "'${iso_base}' não está assinado - não é usado para verificação. A usar '${clearsigned_base}' em vez disso, uma soma de verificação autoassinada e autónoma da ISO."

#, sh-format
msgid "'${iso_base}' is unsigned - not used for verification. Using '${candidate_sig_base}' instead, the ISO's own direct signature."
msgstr "'${iso_base}' não está assinado - não é usado para verificação. A usar '${candidate_sig_base}' em vez disso, a assinatura direta do próprio ISO."

#, sh-format
msgid "'${iso_base}' is an unsigned checksum file, and '${candidate_base}' has no direct .sig/.asc/.gpg/.sign of its own, nor a self-contained clearsigned checksum (e.g. '.sha512.asc') either - nothing here can be cryptographically verified."
msgstr "'${iso_base}' é um ficheiro de somas de verificação não assinado, e '${candidate_base}' também não tem um .sig/.asc/.gpg/.sign direto próprio nem uma soma de verificação autoassinada e autónoma (por ex. '.sha512.asc') - nada aqui pode ser verificado criptograficamente."

#, sh-format
msgid "this is a signature file for a checksum listing, but '${iso_base}' isn't in the same folder"
msgstr "este é um ficheiro de assinatura de uma lista de somas de verificação, mas '${iso_base}' não está na mesma pasta"

#, sh-format
msgid "cannot read checksum listing '${iso_base}'"
msgstr "não é possível ler a lista de somas de verificação '${iso_base}'"

#, sh-format
msgid "using checksum file: ${iso_base} (${algo})"
msgstr "a usar o ficheiro de somas de verificação: ${iso_base} (${algo})"

#, sh-format
msgid "checksum file signature: ${sigfile_base}"
msgstr "assinatura do ficheiro de somas de verificação: ${sigfile_base}"

#, sh-format
msgid "'${iso_base}' is a checksum listing (it can cover many ISOs), not a single ISO to verify directly - none of the .iso files it mentions are present in '${dir}'. Point this tool at the actual .iso file instead (its checksum/signature will be found and checked automatically)."
msgstr "'${iso_base}' é uma lista de somas de verificação (pode cobrir vários ISO), e não um único ISO a verificar diretamente - nenhum dos ficheiros .iso que menciona está presente em '${dir}'. Aponte esta ferramenta para o ficheiro .iso real (a sua soma de verificação/assinatura será encontrada e verificada automaticamente)."

#, sh-format
msgid "'${iso_base}' is a checksum listing covering multiple ISOs present in '${dir}': ${candidates_joined} - point this tool at the specific .iso file you want to check instead."
msgstr "'${iso_base}' é uma lista de somas de verificação que cobre vários ISO presentes em '${dir}': ${candidates_joined} - aponte esta ferramenta diretamente para o ficheiro .iso específico que deseja verificar."

#, sh-format
msgid "this line claims ${tag_algo}, but its hash is ${hash_len} characters long, which looks like ${len_algo} instead - using ${len_algo}"
msgstr "esta linha indica ${tag_algo}, mas o seu hash tem ${hash_len} caracteres, o que parece antes ${len_algo} - a usar ${len_algo}"

#. TRANSLATORS: ${FLAG_CHECKSUM_ALGO}/${FLAG_CHECKSUM_FILE} are literal flag names - keep placeholders as-is.
#, sh-format
msgid "${FLAG_CHECKSUM_ALGO} is required when ${FLAG_CHECKSUM_FILE} names a file not in the built-in list (SHA512SUMS, SHA256SUMS, sha256sum.txt, ...)"
msgstr "${FLAG_CHECKSUM_ALGO} é obrigatório quando ${FLAG_CHECKSUM_FILE} indica um ficheiro que não está na lista incorporada (SHA512SUMS, SHA256SUMS, sha256sum.txt, ...)"

#, sh-format
msgid "could not fetch the signing key for checksum file '${name_base}' from any keyserver - nothing in it could be checked. This looks like a network problem, not necessarily a bad signature - try again once you have a working connection."
msgstr "não foi possível obter a chave de assinatura do ficheiro de somas de verificação '${name_base}' de nenhum servidor de chaves - nada nele pôde ser verificado. Isto parece um problema de rede, não necessariamente uma assinatura inválida - tente novamente quando tiver ligação."

#, sh-format
msgid "the checksum file '${name_base}' failed its own signature check - it cannot be trusted, so the ISO hash inside it cannot be trusted either. Re-download the ISO and the checksum/signature files, ideally from a different mirror."
msgstr "o ficheiro de somas de verificação '${name_base}' falhou a sua própria verificação de assinatura - não é de confiança, pelo que o hash do ISO nele contido também não é de confiança. Volte a transferir o ISO e os ficheiros de soma de verificação/assinatura, de preferência a partir de um servidor espelho diferente."

#, sh-format
msgid "${name_base} is named for ${name_algo}, but its content looks like ${content_algo} - using ${content_algo}"
msgstr "${name_base} tem nome para ${name_algo}, mas o conteúdo parece ${content_algo} - a usar ${content_algo}"

#, sh-format
msgid "checksum file '${name_base}' uses an unsupported hash algorithm ('${hashcmd}' not found)"
msgstr "o ficheiro de somas de verificação '${name_base}' usa um algoritmo de hash não suportado ('${hashcmd}' não encontrado)"

#, sh-format
msgid "using checksum file: ${name_base} (${algo})"
msgstr "a usar o ficheiro de somas de verificação: ${name_base} (${algo})"

#, sh-format
msgid "'${name_base}' is validly signed, but '${base}' does not match the recorded ${algo} checksum - this download is likely corrupted, incomplete, or was tampered with after the checksum file was signed. Re-download the ISO, ideally from a different mirror. (The checksum/signature files themselves are fine - no need to re-fetch those.)"
msgstr "'${name_base}' está validamente assinado, mas '${base}' não corresponde à soma de verificação ${algo} registada - esta transferência está provavelmente corrompida, incompleta, ou foi adulterada depois de o ficheiro de somas de verificação ter sido assinado. Volte a transferir o ISO, de preferência a partir de um servidor espelho diferente. (Os próprios ficheiros de soma de verificação/assinatura estão corretos - não é necessário voltar a obtê-los.)"

msgid "OK - signature and checksum both verified"
msgstr "OK - assinatura e soma de verificação ambas verificadas"

#, sh-format
msgid "no signature file (.sig/.asc/.gpg/.sign) was found for '${override_base}' - cannot verify it without one"
msgstr "não foi encontrado nenhum ficheiro de assinatura (.sig/.asc/.gpg/.sign) para '${override_base}' - não é possível verificá-lo sem um"

#, sh-format
msgid "'${base}' is not listed in '${CHECKSUM_FILE_OVERRIDE}'"
msgstr "'${base}' não está listado em '${CHECKSUM_FILE_OVERRIDE}'"

#, sh-format
msgid "no signature file found for '${base}', and none of the checksum-listing files in its directory (${tried_joined}) contain an entry for it either"
msgstr "não foi encontrado nenhum ficheiro de assinatura para '${base}', e nenhum dos ficheiros de lista de somas de verificação na sua pasta (${tried_joined}) contém uma entrada para ele"

#, sh-format
msgid "no signature file or checksum listing was found for '${base}'"
msgstr "não foi encontrado nenhum ficheiro de assinatura nem nenhuma lista de somas de verificação para '${base}'"

#, sh-format
msgid "cannot read ISO file '${ISO}'"
msgstr "não é possível ler o ficheiro ISO '${ISO}'"

#, sh-format
msgid "cannot read signature file '${SIG}'"
msgstr "não é possível ler o ficheiro de assinatura '${SIG}'"

msgid "gpgv not found"
msgstr "gpgv não encontrado"

msgid "gpg not found"
msgstr "gpg não encontrado"

#, sh-format
msgid "could not extract signing key fingerprint from '${ISO}'"
msgstr "não foi possível extrair a impressão digital da chave de assinatura de '${ISO}'"

#, sh-format
msgid "'${SIG}' looks like a full clearsigned message (e.g. a checksum listing), not a plain detached signature - point this tool at it on its own, or together with the ISO it checksums, not as a signature file."
msgstr "'${SIG}' parece uma mensagem assinada em texto simples completa (por exemplo, uma lista de somas de verificação), não uma simples assinatura destacada - aponte esta ferramenta a ele sozinho, ou junto com a ISO que verifica, não como ficheiro de assinatura."

#, sh-format
msgid "could not extract signing key fingerprint from '${SIG}'"
msgstr "não foi possível extrair a impressão digital da chave de assinatura de '${SIG}'"

#, sh-format
msgid "signature made with: ${FPR}"
msgstr "assinatura feita com: ${FPR}"

#, sh-format
msgid "recognized signing key: ${label}"
msgstr "chave de assinatura reconhecida: ${label}"

#, sh-format
msgid "recognized: key already cached and trusted in ${TRUSTED_GPG}"
msgstr "reconhecida: chave já em cache e de confiança em ${TRUSTED_GPG}"

#, sh-format
msgid "recognized: key found in mx-gpg-keyring - ${mx_uid}"
msgstr "reconhecida: chave encontrada em mx-gpg-keyring - ${mx_uid}"

msgid "recognized: key found in mx-gpg-keyring"
msgstr "reconhecida: chave encontrada em mx-gpg-keyring"

#, sh-format
msgid "kept ${FPR} in ${TRUSTED_GPG} - future runs will recognize it automatically"
msgstr "mantida ${FPR} em ${TRUSTED_GPG} - as futuras execuções irão reconhecê-la automaticamente"

#, sh-format
msgid "warning: could not save key into ${TRUSTED_GPG}: ${out}"
msgstr "aviso: não foi possível guardar a chave em ${TRUSTED_GPG}: ${out}"

#, sh-format
msgid "recognized: key already present in ${PUBRING_KBX} and explicitly marked trusted there"
msgstr "reconhecida: chave já presente em ${PUBRING_KBX} e explicitamente marcada como de confiança aí"

#, sh-format
msgid "${FPR} has been explicitly untrusted - you've told this tool not to auto-trust it anymore, whatever the reason it would otherwise be recognized. Pass ${FLAG_TRUST_KEY} again if you've changed your mind"
msgstr "${FPR} foi explicitamente revogada - indicou a esta ferramenta para não confiar mais nela automaticamente, seja qual for o motivo pelo qual seria reconhecida de outra forma. Use ${FLAG_TRUST_KEY} novamente se mudou de ideia"

#, sh-format
msgid "${FPR} is not one of this tool's built-in recognized keys - verify its fingerprint independently before trusting it (e.g. against the distro's own official website or keyserver listing)"
msgstr "${FPR} não é uma das chaves incorporadas que esta ferramenta já reconhece - verifique a sua impressão digital de forma independente antes de confiar nela (por exemplo, no sítio oficial da distribuição ou num servidor de chaves)"

#. TRANSLATORS: ${FLAG_ALLOW_UNKNOWN}/${FLAG_TRUST_KEY} are literal flag names - keep placeholders as-is.
#, sh-format
msgid "refusing to verify against an unrecognized signing key (pass ${FLAG_ALLOW_UNKNOWN} to verify just this once, or ${FLAG_TRUST_KEY} to also remember it for next time)"
msgstr "a recusar verificar com uma chave de assinatura não reconhecida (indique ${FLAG_ALLOW_UNKNOWN} para verificar apenas desta vez, ou ${FLAG_TRUST_KEY} para também a memorizar para a próxima vez)"

#. TRANSLATORS: ${FLAG_TRUST_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "verifying anyway - if the result below is GOOD and you decide you trust this key, use ${FLAG_TRUST_KEY} next time (or mark it trusted in your own GPG keyring) so future checks recognize it automatically"
msgstr "a verificar de qualquer forma - se o resultado abaixo for BOA e decidir confiar nesta chave, utilize ${FLAG_TRUST_KEY} da próxima vez (ou marque-a como de confiança no seu próprio chaveiro GPG) para que as futuras verificações a reconheçam automaticamente"

#, sh-format
msgid "kept ${FPR} in ${TRUSTED_GPG} - already fetched during verification, no second fetch needed"
msgstr "mantida ${FPR} em ${TRUSTED_GPG} - já obtida durante a verificação, não foi necessário voltar a obtê-la"

#, sh-format
msgid "key already present and valid in ${TRUSTED_GPG}"
msgstr "chave já presente e válida em ${TRUSTED_GPG}"

#, sh-format
msgid "key in ${TRUSTED_GPG} is ${status}, ignoring cached copy"
msgstr "a chave em ${TRUSTED_GPG} está ${status}, a ignorar a cópia em cache"

#, sh-format
msgid "key already present and valid in ${PUBRING_KBX}"
msgstr "chave já presente e válida em ${PUBRING_KBX}"

#, sh-format
msgid "key in ${PUBRING_KBX} is ${pr_status}, ignoring cached copy"
msgstr "a chave em ${PUBRING_KBX} está ${pr_status}, a ignorar a cópia em cache"

msgid "key already present and valid in mx-gpg-keyring"
msgstr "chave já presente e válida em mx-gpg-keyring"

#, sh-format
msgid "fetching ${FPR} from ${ks}"
msgstr "a obter ${FPR} de ${ks}"

#, sh-format
msgid "${ks} returned more than one key for Key ID ${FPR} - refusing to guess which one is real"
msgstr "${ks} devolveu mais do que uma chave para o ID de chave ${FPR} - a recusar adivinhar qual é a verdadeira"

#, sh-format
msgid "${ks} returned ${FPR} without any usable key material (likely a user ID that was never confirmed there) - trying next..."
msgstr "${ks} devolveu ${FPR} sem qualquer material de chave utilizável (provavelmente um ID de utilizador nunca confirmado aí) - a tentar o seguinte..."

#, sh-format
msgid "could not fetch from ${ks}, trying next..."
msgstr "não foi possível obter de ${ks}, a tentar o seguinte..."

#, sh-format
msgid "could not fetch key ${FPR} from any keyserver (tried: ${TRIED_KEYSERVERS}) - this looks like a network problem, not necessarily an invalid signature. Try again once you have a working connection."
msgstr "não foi possível obter a chave ${FPR} de nenhum servidor de chaves (tentado: ${TRIED_KEYSERVERS}) - isto parece um problema de rede, não necessariamente uma assinatura inválida. Tente novamente quando tiver ligação."

#, sh-format
msgid "could not fetch key ${FPR} from any keyserver (tried: ${TRIED_KEYSERVERS})"
msgstr "não foi possível obter a chave ${FPR} de nenhum servidor de chaves (tentados: ${TRIED_KEYSERVERS})"

#, sh-format
msgid "keeping fetched key in ${TRUSTED_GPG} for future runs"
msgstr "a manter a chave obtida em ${TRUSTED_GPG} para futuras execuções"

#, sh-format
msgid "warning: could not save key into ${TRUSTED_GPG} (${out}), continuing with a throw-away keyring for this run"
msgstr "aviso: não foi possível guardar a chave em ${TRUSTED_GPG} (${out}), a continuar com um chaveiro descartável para esta execução"

#, sh-format
msgid "could not save key into ${TRUSTED_GPG}: ${out}"
msgstr "não foi possível guardar a chave em ${TRUSTED_GPG}: ${out}"

#, sh-format
msgid "${FPR} is already kept in ${TRUSTED_GPG}"
msgstr "${FPR} já está guardada em ${TRUSTED_GPG}"

#, sh-format
msgid "verifying inline-signed checksum file '${ISO_BASE}'"
msgstr "a verificar o ficheiro de somas de verificação auto-assinado '${ISO_BASE}'"

#, sh-format
msgid "verifying '${SIG_BASE}' against '${ISO_BASE}'"
msgstr "a verificar '${SIG_BASE}' com base em '${ISO_BASE}'"

msgid "OK - signature verified"
msgstr "OK - assinatura verificada"

#, sh-format
msgid "claimed identity: ${CLAIMED_UID}"
msgstr "identidade declarada: ${CLAIMED_UID}"

#, sh-format
msgid "primary key: ${PRIMARY_FPR}"
msgstr "chave primária: ${PRIMARY_FPR}"

msgid "FAILED - signature did NOT verify"
msgstr "FALHADO - a assinatura NÃO foi verificada"

msgid "refusing to run as root - run this as a regular user instead"
msgstr "recusa-se a executar como root - execute isto com um utilizador normal"

msgid "iso;sig;gpg;"
msgstr "iso;sig;gpg;assinatura;"

msgid "Verify with Drag & Drop"
msgstr "Verificar arrastando e soltando"

#~ msgid "Refresh Trusted Keys"
#~ msgstr "Atualizar Chaves de Confiança"

