#: verify-iso-sig-gui.sh:180
msgid "Verify ISO signature"
msgstr "Verificar a assinatura do ISO"

#: verify-iso-sig-gui.sh:184
msgid "Trust this key"
msgstr "Confiar nesta chave"

#: verify-iso-sig-gui.sh:185
msgid "Check Another File"
msgstr "Verificar outro ficheiro"

#: verify-iso-sig-gui.sh:260 verify-iso-sig-gui.sh:277
#: verify-iso-sig-gui.sh:1881
msgid "OK"
msgstr "OK"

#: verify-iso-sig-gui.sh:295 verify-iso-sig.desktop.in:3
msgid "ISO Signature Verifier"
msgstr "Verificador de assinaturas ISO"

#: verify-iso-sig-gui.sh:296 verify-iso-sig.desktop.in:4
msgid ""
"Check the GPG signature of a downloaded ISO (built-in support for MX Linux/"
"antiX signing keys)"
msgstr ""
"Verifica a assinatura GPG de um ISO transferido (suporte integrado para as "
"chaves de assinatura do MX Linux/antiX)"

#: verify-iso-sig-gui.sh:325
msgid ""
"Check the GPG signature of a downloaded ISO\\n(built-in support for MX Linux/"
"antiX signing keys)"
msgstr ""
"Verifica a assinatura GPG de um ISO transferido\\n(suporte integrado para as "
"chaves de assinatura do MX Linux/antiX)"

#: verify-iso-sig-gui.sh:329
msgid "License: GNU GPL v3 or later"
msgstr "Licença: GNU GPL v3 ou posterior"

#: verify-iso-sig-gui.sh:332
#, sh-format
msgid "About ${ABOUT_TITLE}"
msgstr "Acerca de ${ABOUT_TITLE}"

#: verify-iso-sig-gui.sh:340 verify-iso-sig-gui.sh:467
msgid "Close"
msgstr "Fechar"

#: verify-iso-sig-gui.sh:407 verify-iso-sig-gui.sh:952
#: verify-iso-sig-gui.sh:1045 verify-iso-sig.desktop.in:18
msgid "Manage Trusted Keys"
msgstr "Gerir chaves de confiança"

#: verify-iso-sig-gui.sh:408
msgid "Forget Selected"
msgstr "Esquecer selecionadas"

#: verify-iso-sig-gui.sh:409
msgid "Import Selected"
msgstr "Importar selecionadas"

#: verify-iso-sig-gui.sh:415
msgid "Could not read the list of trusted keys:"
msgstr "Não foi possível ler a lista de chaves de confiança:"

#: verify-iso-sig-gui.sh:418
msgid "No signing keys are currently saved in trustedkeys.gpg."
msgstr ""
"Atualmente não há nenhuma chave de assinatura guardada em trustedkeys.gpg."

#. TRANSLATORS: "Trust"/"Keep" here are informal short references to
#. the main GUI's "Trust this key"/"Keep this key" button labels, not
#. verbatim quotes - no need to match those translated labels exactly.
#. The straight quotes around each word are just English's own
#. convention - please use your language's own quotation marks
#. instead (e.g. « », „", etc.) if that reads more naturally.
#: verify-iso-sig-gui.sh:425
msgid ""
"A key ends up there after you choose to \"Trust\"/\"Keep\" it while "
"verifying an ISO."
msgstr ""
"Uma chave acaba lá depois de escolher «Confiar»/«Manter» ao verificar um ISO."

#: verify-iso-sig-gui.sh:450
msgid "Remove"
msgstr "Remover"

#: verify-iso-sig-gui.sh:451 verify-iso-sig-gui.sh:601
msgid "Fingerprint"
msgstr "Impressão digital"

#: verify-iso-sig-gui.sh:452 verify-iso-sig-gui.sh:602
msgid "Key ID"
msgstr "ID da chave"

#: verify-iso-sig-gui.sh:453 verify-iso-sig-gui.sh:603
msgid "User ID"
msgstr "ID do utilizador"

#: verify-iso-sig-gui.sh:454 verify-iso-sig-gui.sh:604
msgid "Status"
msgstr "Estado"

#: verify-iso-sig-gui.sh:455 verify-iso-sig-gui.sh:605
msgid "Expiration Date"
msgstr "Data de expiração"

#. TRANSLATORS: ${BTN_FORGET_SELECTED} is the translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:465
#, sh-format
msgid ""
"Keys saved in ~/.gnupg/trustedkeys.gpg - check any you want to forget, then "
"click \"${BTN_FORGET_SELECTED}\"."
msgstr ""
"Chaves guardadas em ~/.gnupg/trustedkeys.gpg - assinale as que deseja "
"esquecer e depois clique em «${BTN_FORGET_SELECTED}»."

#: verify-iso-sig-gui.sh:471
msgid "Export Selected"
msgstr "Exportar selecionadas"

#: verify-iso-sig-gui.sh:472
msgid "Import from File"
msgstr "Importar de ficheiro"

#. TRANSLATORS: shown as-is in the list's "Status" column (a
#. gpg key's trust validity), one word each.
#: verify-iso-sig-gui.sh:486 verify-iso-sig-gui.sh:620
msgid "valid"
msgstr "válida"

#. TRANSLATORS: same "Status" column as "valid" above.
#: verify-iso-sig-gui.sh:488 verify-iso-sig-gui.sh:621
msgid "expired"
msgstr "expirada"

#. TRANSLATORS: same "Status" column as "valid" above.
#: verify-iso-sig-gui.sh:490 verify-iso-sig-gui.sh:622
msgid "revoked"
msgstr "revogada"

#. TRANSLATORS: shown in the "Expires" column when the key has
#. no expiration date set.
#: verify-iso-sig-gui.sh:498 verify-iso-sig-gui.sh:635
msgid "never"
msgstr "nunca"

#: verify-iso-sig-gui.sh:515
msgid "No key was checked - nothing to export."
msgstr "Não foi assinalada nenhuma chave - nada a exportar."

#: verify-iso-sig-gui.sh:528
msgid "Export Trusted Keys"
msgstr "Exportar chaves de confiança"

#: verify-iso-sig-gui.sh:545
#, sh-format
msgid "Exported ${EXPORT_COUNT} key(s) to ${EXPORT_PATH_SAFE}."
msgstr "${EXPORT_COUNT} chave(s) exportada(s) para ${EXPORT_PATH_SAFE}."

#: verify-iso-sig-gui.sh:547
msgid "Could not export keys:"
msgstr "Não foi possível exportar as chaves:"

#. TRANSLATORS: ${BTN_IMPORT_SELECTED} is the translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:557 verify-iso-sig-gui.sh:594
#: verify-iso-sig-gui.sh:611
msgid "Import Trusted Keys"
msgstr "Importar chaves de confiança"

#: verify-iso-sig-gui.sh:562
msgid "OpenPGP key files"
msgstr "Ficheiros de chave OpenPGP"

#: verify-iso-sig-gui.sh:563
msgid "All files"
msgstr "Todos os ficheiros"

#: verify-iso-sig-gui.sh:573
msgid "Could not read that key file:"
msgstr "Não foi possível ler esse ficheiro de chave:"

#: verify-iso-sig-gui.sh:576
msgid "No keys were found in that file."
msgstr "Não foram encontradas chaves nesse ficheiro."

#: verify-iso-sig-gui.sh:600
msgid "Import"
msgstr "Importar"

#: verify-iso-sig-gui.sh:611
#, sh-format
msgid ""
"Keys found in this file - check any you want to import, then click "
"\"${BTN_IMPORT_SELECTED}\"."
msgstr ""
"Chaves encontradas neste ficheiro - assinale as que deseja importar e depois "
"clique em «${BTN_IMPORT_SELECTED}»."

#: verify-iso-sig-gui.sh:614 verify-iso-sig-gui.sh:728
#: verify-iso-sig-gui.sh:951 verify-iso-sig-gui.sh:1044
#: verify-iso-sig-gui.sh:1245 verify-iso-sig-gui.sh:1475
msgid "Cancel"
msgstr "Cancelar"

#. TRANSLATORS: appended to the Status cell in the
#. import preview when this key is already present in
#. trustedkeys.gpg - lets the user tell "already
#. trusted" apart from "genuinely new" at a glance.
#: verify-iso-sig-gui.sh:630
msgid "(already trusted)"
msgstr "(já de confiança)"

#: verify-iso-sig-gui.sh:648
msgid "No key was checked - nothing to import."
msgstr "Não foi assinalada nenhuma chave - nada a importar."

#: verify-iso-sig-gui.sh:673
#, sh-format
msgid ""
"Processed ${IMPORT_PROCESSED} key(s): ${IMPORT_NEW} new, ${IMPORT_UPDATED} "
"updated, ${IMPORT_UNCHANGED} unchanged."
msgstr ""
"${IMPORT_PROCESSED} chave(s) processada(s): ${IMPORT_NEW} nova(s), "
"${IMPORT_UPDATED} atualizada(s), ${IMPORT_UNCHANGED} inalterada(s)."

#: verify-iso-sig-gui.sh:677
msgid "Could not import keys:"
msgstr "Não foi possível importar as chaves:"

#: verify-iso-sig-gui.sh:684
msgid "No key was checked - nothing to forget."
msgstr "Não foi assinalada nenhuma chave - nada a esquecer."

#. TRANSLATORS: ${COUNT}/${CMD_LIST_KNOWN_KEYS} are literal - keep placeholders as-is.
#: verify-iso-sig-gui.sh:726
#, sh-format
msgid "Forget ${COUNT} selected key(s) from trustedkeys.gpg?"
msgstr "Esquecer ${COUNT} chave(s) selecionada(s) de trustedkeys.gpg?"

#: verify-iso-sig-gui.sh:726
#, sh-format
msgid ""
"If any of them is also one of this tool's built-in recognized keys (run "
"'${CMD_LIST_KNOWN_KEYS}' to see the full list), it will still be recognized "
"automatically next time - this only removes the local cache entry, not that "
"recognition."
msgstr ""
"Se alguma delas também for uma das chaves incorporadas que esta ferramenta "
"reconhece (execute '${CMD_LIST_KNOWN_KEYS}' para ver a lista completa), esta "
"ferramenta continuará a reconhecê-la automaticamente da próxima vez - isto "
"apenas remove a entrada de cache local, não esse reconhecimento."

#: verify-iso-sig-gui.sh:727
msgid "Forget"
msgstr "Esquecer"

#: verify-iso-sig-gui.sh:743
msgid "Some keys could not be removed:"
msgstr "Algumas chaves não puderam ser removidas:"

#: verify-iso-sig-gui.sh:897
msgid ""
"This tool checks that a downloaded ISO is authentic and undamaged, using its "
"signature file or a signed checksum listing."
msgstr ""
"Esta ferramenta verifica se uma ISO transferida é autêntica e não está "
"danificada, utilizando o seu ficheiro de assinatura ou uma lista de somas de "
"verificação assinada."

#: verify-iso-sig-gui.sh:898
msgid ""
"Pick the .iso file, or its .sig/.asc/.gpg/.sign signature file directly."
msgstr ""
"Selecione o ficheiro .iso, ou diretamente o seu ficheiro de "
"assinatura .sig/.asc/.gpg/.sign."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render as
#. bold text, not literal characters).
#: verify-iso-sig-gui.sh:901
msgid ""
"The other one is found automatically - <b>but only if it's in the same "
"folder</b>."
msgstr ""
"O outro ficheiro é encontrado automaticamente - <b>mas apenas se estiver na "
"mesma pasta</b>."

#: verify-iso-sig-gui.sh:948 verify-iso-sig-gui.sh:976
msgid "ISO or signature file"
msgstr "Ficheiro ISO ou de assinatura"

#: verify-iso-sig-gui.sh:950 verify-iso-sig-gui.sh:1043
#: verify-iso-sig-gui.sh:1474
msgid "Verify"
msgstr "Verificar"

#: verify-iso-sig-gui.sh:953 verify-iso-sig-gui.sh:1050
msgid "About"
msgstr "Acerca"

#: verify-iso-sig-gui.sh:999
msgid "Or drag a .iso or signature file here"
msgstr "Ou arraste aqui um ficheiro .iso ou de assinatura"

#: verify-iso-sig-gui.sh:1028
msgid "Pick Files"
msgstr "Selecionar ficheiros"

#: verify-iso-sig-gui.sh:1029
msgid "Drag a File"
msgstr "Arrastar um ficheiro"

#: verify-iso-sig-gui.sh:1115
#, sh-format
msgid ""
"Drop at most two files (the ISO and its signature file) - ${DROP_COUNT} were "
"dropped."
msgstr ""
"Largue no máximo dois ficheiros (o ISO e o seu ficheiro de assinatura) - "
"foram largados ${DROP_COUNT}."

#: verify-iso-sig-gui.sh:1338 verify-iso-sig-gui.sh:1350
msgid ""
"That's a folder, not a file - pick the .iso file itself (or "
"its .sig/.asc/.gpg/.sign signature file) directly."
msgstr ""
"Isso é uma pasta, não um ficheiro - selecione diretamente o próprio "
"ficheiro .iso (ou o seu ficheiro de assinatura .sig/.asc/.gpg/.sign)."

#: verify-iso-sig-gui.sh:1389
msgid "No ISO or signature file was selected."
msgstr "Não foi selecionado nenhum ficheiro ISO nem de assinatura."

#: verify-iso-sig-gui.sh:1397
msgid "Cannot read ISO file:"
msgstr "Não é possível ler o ficheiro ISO:"

#: verify-iso-sig-gui.sh:1408
msgid "Cannot find the matching signature file:"
msgstr "Não foi encontrado o ficheiro de assinatura correspondente:"

#: verify-iso-sig-gui.sh:1413
msgid "Cannot read the checksum-listing file:"
msgstr "Não é possível ler o ficheiro de somas de verificação:"

#: verify-iso-sig-gui.sh:1425 verify-iso-sig-gui.sh:1578
#: verify-iso-sig-gui.sh:1591 verify-iso-sig-gui.sh:1758
#: verify-iso-sig-gui.sh:1762 verify-iso-sig-gui.sh:1767
#: verify-iso-sig-gui.sh:1782 verify-iso-sig-gui.sh:1787
#: verify-iso-sig-gui.sh:1792
msgid "ISO:"
msgstr "ISO:"

#: verify-iso-sig-gui.sh:1429 verify-iso-sig-gui.sh:1592
#: verify-iso-sig-gui.sh:1762 verify-iso-sig-gui.sh:1767
#: verify-iso-sig-gui.sh:1775 verify-iso-sig-gui.sh:1779
#: verify-iso-sig-gui.sh:1787
msgid "SHA:"
msgstr "SHA:"

#: verify-iso-sig-gui.sh:1431 verify-iso-sig-gui.sh:1444
msgid "About to verify:"
msgstr "A verificar:"

#: verify-iso-sig-gui.sh:1435 verify-iso-sig-gui.sh:1442
#: verify-iso-sig-gui.sh:1579 verify-iso-sig-gui.sh:1602
#: verify-iso-sig-gui.sh:1770 verify-iso-sig-gui.sh:1780
#: verify-iso-sig-gui.sh:1790 verify-iso-sig-gui.sh:1792
msgid "SIG:"
msgstr "SIG:"

#: verify-iso-sig-gui.sh:1506
msgid "Verifying signature - this can take a while for a large ISO..."
msgstr ""
"A verificar a assinatura - isto pode demorar algum tempo para um ISO "
"grande..."

#: verify-iso-sig-gui.sh:1508
msgid "Verifying signature - this can take a few seconds"
msgstr "A verificar a assinatura - isto pode demorar alguns segundos"

#. TRANSLATORS: continues the previous line's sentence ("Verifying
#. signature - this can take a few seconds") onto a second line -
#. the two need to read as one continuous sentence together.
#: verify-iso-sig-gui.sh:1512
msgid "if the signing key needs to be fetched from a keyserver..."
msgstr ""
"caso seja necessário obter a chave de assinatura a partir de um servidor de "
"chaves..."

#. TRANSLATORS: ${BTN_TRUST_THIS_KEY} is the translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1570
#, sh-format
msgid ""
"By clicking \"${BTN_TRUST_THIS_KEY}\" you confirm you've checked the Key ID "
"or fingerprint yourself and want to trust and remember this key for future "
"checks."
msgstr ""
"Ao clicar em «${BTN_TRUST_THIS_KEY}» confirma que verificou pessoalmente o "
"ID da chave ou a impressão digital, e que deseja confiar nesta chave e "
"recordá-la para futuras verificações."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
#: verify-iso-sig-gui.sh:1576
msgid "Signature check: <b>GOOD</b> - the ISO exactly matches this key."
msgstr ""
"Verificação da assinatura: <b>BOA</b> - o ISO corresponde exatamente a esta "
"chave."

#: verify-iso-sig-gui.sh:1577
msgid ""
"Note: that identity is self-declared by whoever created the key - it is NOT "
"independently verified, unlike the Key ID or fingerprint. Only trust this "
"key if you've confirmed the Key ID or fingerprint yourself (e.g. from the "
"respin/distro's own official site, or its keyserver listing)."
msgstr ""
"Nota: essa identidade é autodeclarada por quem criou a chave - NÃO é "
"verificada de forma independente, ao contrário do ID da chave ou da "
"impressão digital. Só confie nesta chave se tiver confirmado pessoalmente o "
"ID da chave ou a impressão digital (por exemplo, no site oficial do respin/"
"distribuição, ou num servidor de chaves)."

#: verify-iso-sig-gui.sh:1585
msgid "This ISO's signing key isn't one this tool already recognizes."
msgstr ""
"A chave de assinatura deste ISO não é uma que esta ferramenta já reconheça."

#: verify-iso-sig-gui.sh:1585 verify-iso-sig-gui.sh:1607
#: verify-iso-sig-gui.sh:1631
msgid "Key ID:"
msgstr "ID da chave:"

#: verify-iso-sig-gui.sh:1585 verify-iso-sig-gui.sh:1607
#: verify-iso-sig-gui.sh:1631
msgid "Claimed identity:"
msgstr "Identidade declarada:"

#: verify-iso-sig-gui.sh:1585 verify-iso-sig-gui.sh:1607
#: verify-iso-sig-gui.sh:1631
msgid "Fingerprint:"
msgstr "Impressão digital:"

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
#: verify-iso-sig-gui.sh:1589
msgid ""
"Signature check: <b>GOOD</b> - the checksum listing exactly matches this key "
"(the ISO's own hash is checked separately, next)."
msgstr ""
"Verificação da assinatura: <b>BOA</b> - a lista de somas de verificação "
"corresponde exatamente a esta chave (o próprio hash do ISO é verificado "
"separadamente, a seguir)."

#: verify-iso-sig-gui.sh:1590
msgid ""
"Note: that identity is self-declared by whoever created the key - it is NOT "
"independently verified, unlike the Key ID or fingerprint. Only trust this "
"key if you've confirmed it yourself (e.g. from the distro's own official "
"website or keyserver listing)."
msgstr ""
"Nota: essa identidade é autodeclarada por quem criou a chave - NÃO é "
"verificada de forma independente, ao contrário do ID da chave ou da "
"impressão digital. Só confie nesta chave se a tiver confirmado pessoalmente "
"(por exemplo, no site oficial da distribuição ou num servidor de chaves)."

#: verify-iso-sig-gui.sh:1607
msgid ""
"This checksum-listing file's signing key isn't one this tool already "
"recognizes."
msgstr ""
"A chave de assinatura deste ficheiro de lista de somas de verificação não é "
"uma que esta ferramenta já reconheça."

#: verify-iso-sig-gui.sh:1633
msgid ""
"This signing key currently only lives in your personal keyring (pubring.kbx)."
msgstr ""
"Esta chave de assinatura atualmente só existe no seu chaveiro pessoal "
"(pubring.kbx)."

#: verify-iso-sig-gui.sh:1633
msgid ""
"Copy it into ~/.gnupg/trustedkeys.gpg so future checks don't depend on it "
"staying there?"
msgstr ""
"Copiá-la para ~/.gnupg/trustedkeys.gpg para que as futuras verificações não "
"dependam de ela lá permanecer?"

#: verify-iso-sig-gui.sh:1635
msgid "This signing key was just fetched from a keyserver."
msgstr ""
"Esta chave de assinatura acabou de ser obtida a partir de um servidor de "
"chaves."

#: verify-iso-sig-gui.sh:1635
msgid ""
"Remember it locally, in ~/.gnupg/trustedkeys.gpg, so future checks don't "
"need the network again?"
msgstr ""
"Guardá-la localmente, em ~/.gnupg/trustedkeys.gpg, para que as futuras "
"verificações não precisem novamente da rede?"

#: verify-iso-sig-gui.sh:1651
msgid "Keep this key"
msgstr "Manter esta chave"

#: verify-iso-sig-gui.sh:1652
msgid "No thanks"
msgstr "Não, obrigado"

#: verify-iso-sig-gui.sh:1697
msgid "key saved locally - future checks won't need the network"
msgstr ""
"chave guardada localmente - as futuras verificações não precisarão da rede"

#: verify-iso-sig-gui.sh:1699
msgid "used an already-cached key, no network needed"
msgstr "utilizada uma chave já em cache, sem necessidade de rede"

#: verify-iso-sig-gui.sh:1701
msgid "used a key from your personal keyring (pubring.kbx)"
msgstr "utilizada uma chave do seu chaveiro pessoal (pubring.kbx)"

#: verify-iso-sig-gui.sh:1703
msgid "fetched the signing key from a keyserver"
msgstr "obtida a chave de assinatura a partir de um servidor de chaves"

#. TRANSLATORS: ${KEY_EXPIRY_DATE_SAFE} is a date (e.g. 2026-08-06) - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1716
#, sh-format
msgid ""
"this key expired on ${KEY_EXPIRY_DATE_SAFE} - this does not affect the "
"signature check"
msgstr ""
"esta chave expirou em ${KEY_EXPIRY_DATE_SAFE} - isto não afeta a verificação "
"da assinatura"

#: verify-iso-sig-gui.sh:1718 verify-iso-sig:961
msgid "this key has expired - this does not affect the signature check"
msgstr "esta chave expirou - isto não afeta a verificação da assinatura"

#: verify-iso-sig-gui.sh:1740
msgid "Verified OK"
msgstr "Verificação bem-sucedida"

#: verify-iso-sig-gui.sh:1742
msgid "Key not trusted"
msgstr "Chave não fidedigna"

#: verify-iso-sig-gui.sh:1744
msgid "Nothing to verify"
msgstr "Nada para verificar"

#: verify-iso-sig-gui.sh:1746
msgid "Verification FAILED"
msgstr "Verificação FALHADA"

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE}/${BTN_TRUST_THIS_KEY} are translated button labels - keep placeholders as-is.
#: verify-iso-sig-gui.sh:1810
#, sh-format
msgid ""
"The cryptographic check itself already came back GOOD (see the technical "
"details below) - you just haven't trusted this signing key yet. If you're "
"confident this is the genuine key (e.g. you've checked its fingerprint "
"against the distro's own official site or keyserver listing), click "
"\"${BTN_CHECK_ANOTHER_FILE}\" and choose \"${BTN_TRUST_THIS_KEY}\" this time."
msgstr ""
"A própria verificação criptográfica já tinha sido BOA (veja os detalhes "
"técnicos abaixo) - simplesmente ainda não confiou nesta chave de assinatura. "
"Se tiver a certeza de que é a chave genuína (por exemplo, verificou a sua "
"impressão digital no sítio oficial da distribuição ou num servidor de "
"chaves), clique em «${BTN_CHECK_ANOTHER_FILE}» e escolha desta vez "
"«${BTN_TRUST_THIS_KEY}»."

#: verify-iso-sig-gui.sh:1812
msgid ""
"The cryptographic check itself already came back GOOD (see the technical "
"details below) - the key just couldn't be saved for future trust (see the "
"technical details for why). Feel free to try again."
msgstr ""
"A própria verificação criptográfica já tinha sido BOA (veja os detalhes "
"técnicos abaixo) - a chave apenas não pôde ser guardada para confiança "
"futura (veja os detalhes técnicos para saber porquê). Sinta-se à vontade "
"para tentar novamente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1815
#, sh-format
msgid ""
"You pointed this tool at a checksum-listing file, not a single ISO - it can "
"cover many ISOs at once, so there's no one file to check unless exactly one "
"of the ones it mentions is actually present here (see the technical details "
"below for which). Use \"${BTN_CHECK_ANOTHER_FILE}\" and point at the "
"actual .iso file instead."
msgstr ""
"Apontou esta ferramenta para um ficheiro de lista de somas de verificação, "
"não para um único ISO - esse ficheiro pode cobrir vários ISO ao mesmo tempo, "
"pelo que não há um único ficheiro a verificar, a menos que exatamente um dos "
"que menciona esteja realmente presente aqui (veja os detalhes técnicos "
"abaixo para saber qual). Utilize «${BTN_CHECK_ANOTHER_FILE}» e aponte "
"diretamente para o ficheiro .iso real."

#: verify-iso-sig-gui.sh:1817
msgid ""
"No signature file or signed checksum listing was found for this ISO - "
"there's nothing here to check yet."
msgstr ""
"Não foi encontrado nenhum ficheiro de assinatura nem nenhuma lista de somas "
"de verificação assinada para esta ISO - ainda não há nada para verificar "
"aqui."

#. TRANSLATORS: ${CHECKSUM_FILE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1823 verify-iso-sig-gui.sh:1830
#, sh-format
msgid ""
"This checksum listing (${CHECKSUM_FILE_SAFE}) has no signature file of its "
"own (.sig/.asc/.gpg/.sign) next to it - it can't be trusted without one, so "
"it was never checked against this ISO."
msgstr ""
"Esta lista de somas de verificação (${CHECKSUM_FILE_SAFE}) não tem um "
"ficheiro de assinatura próprio (.sig/.asc/.gpg/.sign) ao seu lado - sem ele "
"não é possível confiar nela, por isso nunca foi verificada em relação a esta "
"ISO."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1834
#, sh-format
msgid ""
"This is a signature file, but its ISO ('${DISPLAY_ISO_SAFE}') isn't in the "
"same folder - this tool only looks for a counterpart next to the file you "
"pick."
msgstr ""
"Este é um ficheiro de assinatura, mas a sua ISO ('${DISPLAY_ISO_SAFE}') não "
"está na mesma pasta - esta ferramenta só procura o correspondente ao lado do "
"ficheiro que escolher."

#. TRANSLATORS: ${LISTING_BASE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1839
#, sh-format
msgid ""
"This is a signature file for a checksum listing, but '${LISTING_BASE_SAFE}' "
"isn't in the same folder - this tool only looks for a counterpart next to "
"the file you pick."
msgstr ""
"Este é um ficheiro de assinatura de uma lista de somas de verificação, mas "
"'${LISTING_BASE_SAFE}' não está na mesma pasta - esta ferramenta só procura "
"o correspondente ao lado do ficheiro que escolher."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1843
#, sh-format
msgid ""
"Neither '${DISPLAY_ISO_SAFE}' nor a signature file for it were found in this "
"folder - nothing to check yet."
msgstr ""
"Não foi encontrado nem o ficheiro '${DISPLAY_ISO_SAFE}' nem um ficheiro de "
"assinatura para ele nesta pasta - ainda não há nada para verificar."

#: verify-iso-sig-gui.sh:1845
msgid ""
"This checksum file isn't signed, and the ISO it describes has no signature "
"of its own either - there's nothing here this tool can cryptographically "
"verify. Check whether the distro provides a signed checksum listing or a "
"direct .sig/.asc/.gpg file for this ISO."
msgstr ""
"Este ficheiro de somas de verificação não está assinado, e o ISO que "
"descreve também não tem assinatura própria - não há aqui nada que esta "
"ferramenta possa verificar criptograficamente. Verifique se a distribuição "
"fornece uma lista de somas de verificação assinada ou um "
"ficheiro .sig/.asc/.gpg direto para este ISO."

#: verify-iso-sig-gui.sh:1847
msgid ""
"The checksum file that lists this ISO's hash failed its own verification "
"(bad/untrusted signature, or its key couldn't be confirmed) - nothing in it "
"can be trusted. Re-download the checksum/signature files (and probably the "
"ISO too), ideally from a different mirror."
msgstr ""
"O ficheiro de somas de verificação que lista o hash deste ISO falhou a sua "
"própria verificação (assinatura inválida/não fiável, ou não foi possível "
"confirmar a sua chave) - nada nele é de confiança. Volte a transferir os "
"ficheiros de soma de verificação/assinatura (e provavelmente também o ISO), "
"de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${CHECKSUM_INFO_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1851
#, sh-format
msgid ""
"This ISO was checked against a signed checksum listing "
"(${CHECKSUM_INFO_SAFE}) that IS validly signed - but the ISO's own hash "
"doesn't match what's listed. The checksum list itself is trustworthy; this "
"particular download is not. Re-download the ISO, ideally from a different "
"mirror."
msgstr ""
"Este ISO foi verificado com base numa lista de somas de verificação assinada "
"(${CHECKSUM_INFO_SAFE}) que ESTÁ validamente assinada - mas o próprio hash "
"do ISO não corresponde ao que está listado. A lista de somas de verificação "
"em si é de confiança; esta transferência em particular não é. Volte a "
"transferir o ISO, de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1854
#, sh-format
msgid ""
"No direct signature file was found for this ISO, and none of the checksum-"
"listing files found nearby mention this exact ISO filename either. If this "
"distro uses a different naming convention, use \"${BTN_CHECK_ANOTHER_FILE}\" "
"and point at the right file directly."
msgstr ""
"Não foi encontrado nenhum ficheiro de assinatura direto para este ISO, e "
"nenhum dos ficheiros de lista de somas de verificação encontrados nas "
"proximidades menciona também este nome exato de ficheiro ISO. Se esta "
"distribuição utilizar uma convenção de nomenclatura diferente, utilize "
"«${BTN_CHECK_ANOTHER_FILE}» e aponte diretamente para o ficheiro correto."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#: verify-iso-sig-gui.sh:1857
#, sh-format
msgid ""
"The file names don't match, so this signature file may simply not belong to "
"this .iso. Use \"${BTN_CHECK_ANOTHER_FILE}\" and pick the signature file "
"named exactly like the ISO plus .sig/.asc/.gpg."
msgstr ""
"Os nomes dos ficheiros não correspondem, pelo que este ficheiro de "
"assinatura pode simplesmente não pertencer a este .iso. Utilize "
"«${BTN_CHECK_ANOTHER_FILE}» e selecione o ficheiro de assinatura com o nome "
"exatamente igual ao do ISO mais .sig/.asc/.gpg."

#: verify-iso-sig-gui.sh:1859
msgid ""
"On top of the signature not matching, this signing key also isn't one this "
"tool already recognizes - treat this file as untrustworthy and re-download "
"from an official source."
msgstr ""
"Além de a assinatura não corresponder, esta chave de assinatura também não é "
"uma que esta ferramenta já reconheça - trate este ficheiro como não fiável e "
"volte a transferi-lo a partir de uma fonte oficial."

#: verify-iso-sig-gui.sh:1861
msgid ""
"The ISO may be corrupted, or the download was incomplete or tampered with - "
"try re-downloading it, ideally from a different mirror."
msgstr ""
"O ISO pode estar corrompido, ou a transferência ficou incompleta ou foi "
"adulterada - tente transferi-lo novamente, de preferência a partir de um "
"servidor espelho diferente."

