#~ msgstr "reconhecida: chave encontrada no próprio pacote de chaves de assinatura deste sistema (${MX_GPG_KEYRING})"

#, sh-format
#~ msgid "key already present and valid in this system's own signing-key package (${MX_GPG_KEYRING})"
#~ msgstr "chave já presente e válida no próprio pacote de chaves de assinatura deste sistema (${MX_GPG_KEYRING})"

