msgstr ""
"Project-Id-Version: verify-iso-sig\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-08-15 17:32+0200\n"
"PO-Revision-Date: 2026-07-30 23:30+0200\n"
"Last-Translator: \n"
"Language-Team: Portuguese\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Verify ISO signature"
msgstr "Verificar a assinatura do ISO"

msgid "Trust this key"
msgstr "Confiar nesta chave"

msgid "Check Another File"
msgstr "Verificar outro ficheiro"

msgid ""
"error: refusing to run as root - run this as your normal desktop user instead"
msgstr ""
"erro: recusa-se a executar como root - execute isto com o seu utilizador "
"normal"

msgid "OK"
msgstr "OK"

msgid "ISO Signature Verifier"
msgstr "Verificador de assinaturas ISO"

msgid ""
"Check the GPG signature of a downloaded ISO (built-in support for MX Linux/"
"antiX signing keys)"
msgstr ""
"Verifica a assinatura GPG de um ISO transferido (suporte integrado para as "
"chaves de assinatura do MX Linux/antiX)"

#, sh-format
msgid "Version ${VERSION}"
msgstr "Versão ${VERSION}"

msgid ""
"Check the GPG signature of a downloaded ISO\\n(built-in support for MX Linux/"
"antiX signing keys)"
msgstr ""
"Verifica a assinatura GPG de um ISO transferido\\n(suporte integrado para as "
"chaves de assinatura do MX Linux/antiX)"

msgid "License: GNU GPL v3 or later"
msgstr "Licença: GNU GPL v3 ou posterior"

#, sh-format
msgid "About ${ABOUT_TITLE}"
msgstr "Acerca de ${ABOUT_TITLE}"

msgid "Close"
msgstr "Fechar"

msgid "Manage Trusted Keys"
msgstr "Gerir chaves de confiança"

msgid "Forget Selected"
msgstr "Esquecer selecionadas"

msgid "Import Selected"
msgstr "Importar selecionadas"

msgid "Could not read the list of trusted keys:"
msgstr "Não foi possível ler a lista de chaves de confiança:"

msgid "No signing keys are currently saved in trustedkeys.gpg."
msgstr ""
"Atualmente não há nenhuma chave de assinatura guardada em trustedkeys.gpg."

#. TRANSLATORS: "Trust"/"Keep" here are informal short references to
#. the main GUI's "Trust this key"/"Keep this key" button labels, not
#. verbatim quotes - no need to match those translated labels exactly.
#. The straight quotes around each word are just English's own
#. convention - please use your language's own quotation marks
#. instead (e.g. « », „", etc.) if that reads more naturally.
msgid ""
"A key ends up there after you choose to \"Trust\"/\"Keep\" it while "
"verifying an ISO."
msgstr ""
"Uma chave acaba lá depois de escolher «Confiar»/«Manter» ao verificar um ISO."

msgid "Remove"
msgstr "Remover"

msgid "Fingerprint"
msgstr "Impressão digital"

msgid "Key ID"
msgstr "ID da chave"

msgid "User ID"
msgstr "ID do utilizador"

msgid "Status"
msgstr "Estado"

msgid "Expiration Date"
msgstr "Data de expiração"

#. TRANSLATORS: ${BTN_FORGET_SELECTED} is the translated button label - keep the placeholder as-is.
#, sh-format
msgid ""
"Keys saved in ~/.gnupg/trustedkeys.gpg - check any you want to forget, then "
"click \"${BTN_FORGET_SELECTED}\"."
msgstr ""
"Chaves guardadas em ~/.gnupg/trustedkeys.gpg - assinale as que deseja "
"esquecer e depois clique em «${BTN_FORGET_SELECTED}»."

msgid "Export Selected"
msgstr "Exportar selecionadas"

msgid "Import from File"
msgstr "Importar de ficheiro"

#. TRANSLATORS: shown as-is in the list's "Status" column (a
#. gpg key's trust validity), one word each.
msgid "valid"
msgstr "válida"

#. TRANSLATORS: same "Status" column as "valid" above.
msgid "expired"
msgstr "expirada"

#. TRANSLATORS: same "Status" column as "valid" above.
msgid "revoked"
msgstr "revogada"

#. TRANSLATORS: shown in the "Expires" column when the key has
#. no expiration date set.
msgid "never"
msgstr "nunca"

msgid "No key was checked - nothing to export."
msgstr "Não foi assinalada nenhuma chave - nada a exportar."

msgid "Export Trusted Keys"
msgstr "Exportar chaves de confiança"

#, sh-format
msgid "Exported ${EXPORT_COUNT} key(s) to ${EXPORT_PATH_SAFE}."
msgstr "${EXPORT_COUNT} chave(s) exportada(s) para ${EXPORT_PATH_SAFE}."

msgid "Could not export keys:"
msgstr "Não foi possível exportar as chaves:"

#. TRANSLATORS: ${BTN_IMPORT_SELECTED} is the translated button label - keep the placeholder as-is.
msgid "Import Trusted Keys"
msgstr "Importar chaves de confiança"

msgid "OpenPGP key files"
msgstr "Ficheiros de chave OpenPGP"

msgid "All files"
msgstr "Todos os ficheiros"

msgid "Could not read that key file:"
msgstr "Não foi possível ler esse ficheiro de chave:"

msgid "No keys were found in that file."
msgstr "Não foram encontradas chaves nesse ficheiro."

msgid "Import"
msgstr "Importar"

#, sh-format
msgid ""
"Keys found in this file - check any you want to import, then click "
"\"${BTN_IMPORT_SELECTED}\"."
msgstr ""
"Chaves encontradas neste ficheiro - assinale as que deseja importar e depois "
"clique em «${BTN_IMPORT_SELECTED}»."

msgid "Cancel"
msgstr "Cancelar"

#. TRANSLATORS: appended to the Status cell in the
#. import preview when this key is already present in
#. trustedkeys.gpg - lets the user tell "already
#. trusted" apart from "genuinely new" at a glance.
msgid "(already trusted)"
msgstr "(já de confiança)"

msgid "No key was checked - nothing to import."
msgstr "Não foi assinalada nenhuma chave - nada a importar."

#, sh-format
msgid ""
"Processed ${IMPORT_PROCESSED} key(s): ${IMPORT_NEW} new, ${IMPORT_UPDATED} "
"updated, ${IMPORT_UNCHANGED} unchanged."
msgstr ""
"${IMPORT_PROCESSED} chave(s) processada(s): ${IMPORT_NEW} nova(s), "
"${IMPORT_UPDATED} atualizada(s), ${IMPORT_UNCHANGED} inalterada(s)."

msgid "Could not import keys:"
msgstr "Não foi possível importar as chaves:"

msgid "No key was checked - nothing to forget."
msgstr "Não foi assinalada nenhuma chave - nada a esquecer."

#. TRANSLATORS: ${COUNT}/${CMD_LIST_KNOWN_KEYS} are literal - keep placeholders as-is.
#, sh-format
msgid "Forget ${COUNT} selected key(s) from trustedkeys.gpg?"
msgstr "Esquecer ${COUNT} chave(s) selecionada(s) de trustedkeys.gpg?"

#, sh-format
msgid ""
"If any of them is also one of this tool's built-in recognized keys (run "
"'${CMD_LIST_KNOWN_KEYS}' to see the full list), it will still be recognized "
"automatically next time - this only removes the local cache entry, not that "
"recognition."
msgstr ""
"Se alguma delas também for uma das chaves incorporadas que esta ferramenta "
"reconhece (execute '${CMD_LIST_KNOWN_KEYS}' para ver a lista completa), esta "
"ferramenta continuará a reconhecê-la automaticamente da próxima vez - isto "
"apenas remove a entrada de cache local, não esse reconhecimento."

msgid "Forget"
msgstr "Esquecer"

msgid "Some keys could not be removed:"
msgstr "Algumas chaves não puderam ser removidas:"

msgid "Already running - close it first to check this file."
msgstr "Já em execução - feche-o primeiro para verificar este ficheiro."

msgid "Already running."
msgstr "Já em execução."

msgid ""
"This tool checks that a downloaded ISO is authentic and undamaged, using its "
"signature file or a signed checksum listing."
msgstr ""
"Esta ferramenta verifica se uma ISO transferida é autêntica e não está "
"danificada, utilizando o seu ficheiro de assinatura ou uma lista de somas de "
"verificação assinada."

msgid ""
"Pick the .iso file, or its .sig/.asc/.gpg/.sign signature file directly."
msgstr ""
"Selecione o ficheiro .iso, ou diretamente o seu ficheiro de "
"assinatura .sig/.asc/.gpg/.sign."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render as
#. bold text, not literal characters).
msgid ""
"The other one is found automatically - <b>but only if it's in the same "
"folder</b>."
msgstr ""
"O outro ficheiro é encontrado automaticamente - <b>mas apenas se estiver na "
"mesma pasta</b>."

msgid "ISO or signature file"
msgstr "Ficheiro ISO ou de assinatura"

msgid "Help"
msgstr "Ajuda"

msgid "About"
msgstr "Acerca"

msgid "Verify"
msgstr "Verificar"

msgid "Or drag a .iso or signature file here"
msgstr "Ou arraste aqui um ficheiro .iso ou de assinatura"

msgid "Pick Files"
msgstr "Selecionar ficheiros"

msgid "Drag a File"
msgstr "Arrastar um ficheiro"

#, sh-format
msgid ""
"Drop at most two files (the ISO and its signature file) - ${DROP_COUNT} were "
"dropped."
msgstr ""
"Largue no máximo dois ficheiros (o ISO e o seu ficheiro de assinatura) - "
"foram largados ${DROP_COUNT}."

msgid ""
"Could not find a way to open a web browser (xdg-open is missing). Open this "
"address yourself:"
msgstr ""
"Não foi possível encontrar uma forma de abrir um navegador web (falta o xdg-"
"open). Abra este endereço você mesmo:"

msgid ""
"That's a folder, not a file - pick the .iso file itself (or "
"its .sig/.asc/.gpg/.sign signature file) directly."
msgstr ""
"Isso é uma pasta, não um ficheiro - selecione diretamente o próprio "
"ficheiro .iso (ou o seu ficheiro de assinatura .sig/.asc/.gpg/.sign)."

msgid "No ISO or signature file was selected."
msgstr "Não foi selecionado nenhum ficheiro ISO nem de assinatura."

msgid "Cannot read ISO file:"
msgstr "Não é possível ler o ficheiro ISO:"

msgid "Cannot find the matching signature file:"
msgstr "Não foi encontrado o ficheiro de assinatura correspondente:"

msgid "Cannot read the checksum-listing file:"
msgstr "Não é possível ler o ficheiro de somas de verificação:"

msgid "ISO:"
msgstr "ISO:"

msgid "SHA:"
msgstr "SHA:"

msgid "About to verify:"
msgstr "A verificar:"

msgid "SIG:"
msgstr "SIG:"

msgid "Verifying signature - this can take a while for a large ISO..."
msgstr ""
"A verificar a assinatura - isto pode demorar algum tempo para um ISO "
"grande..."

msgid "Verifying signature - this can take a few seconds"
msgstr "A verificar a assinatura - isto pode demorar alguns segundos"

#. TRANSLATORS: continues the previous line's sentence ("Verifying
#. signature - this can take a few seconds") onto a second line -
#. the two need to read as one continuous sentence together.
msgid "if the signing key needs to be fetched from a keyserver..."
msgstr ""
"caso seja necessário obter a chave de assinatura a partir de um servidor de "
"chaves..."

#. TRANSLATORS: ${BTN_TRUST_THIS_KEY} is the translated button label - keep the placeholder as-is.
#, sh-format
msgid ""
"By clicking \"${BTN_TRUST_THIS_KEY}\" you confirm you've checked the Key ID "
"or fingerprint yourself and want to trust and remember this key for future "
"checks."
msgstr ""
"Ao clicar em «${BTN_TRUST_THIS_KEY}» confirma que verificou pessoalmente o "
"ID da chave ou a impressão digital, e que deseja confiar nesta chave e "
"recordá-la para futuras verificações."

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
msgid "Signature check: <b>GOOD</b> - the ISO exactly matches this key."
msgstr ""
"Verificação da assinatura: <b>BOA</b> - o ISO corresponde exatamente a esta "
"chave."

msgid ""
"Note: that identity is self-declared by whoever created the key - it is NOT "
"independently verified, unlike the Key ID or fingerprint. Only trust this "
"key if you've confirmed the Key ID or fingerprint yourself (e.g. from the "
"respin/distro's own official site, or its keyserver listing)."
msgstr ""
"Nota: essa identidade é autodeclarada por quem criou a chave - NÃO é "
"verificada de forma independente, ao contrário do ID da chave ou da "
"impressão digital. Só confie nesta chave se tiver confirmado pessoalmente o "
"ID da chave ou a impressão digital (por exemplo, no site oficial do respin/"
"distribuição, ou num servidor de chaves)."

msgid "This ISO's signing key isn't one this tool already recognizes."
msgstr ""
"A chave de assinatura deste ISO não é uma que esta ferramenta já reconheça."

msgid "Key ID:"
msgstr "ID da chave:"

msgid "Claimed identity:"
msgstr "Identidade declarada:"

msgid "Fingerprint:"
msgstr "Impressão digital:"

#. TRANSLATORS: keep the <b>/</b> tags exactly as-is (they render
#. as bold text, not literal characters).
msgid ""
"Signature check: <b>GOOD</b> - the checksum listing exactly matches this key "
"(the ISO's own hash is checked separately, next)."
msgstr ""
"Verificação da assinatura: <b>BOA</b> - a lista de somas de verificação "
"corresponde exatamente a esta chave (o próprio hash do ISO é verificado "
"separadamente, a seguir)."

msgid ""
"Note: that identity is self-declared by whoever created the key - it is NOT "
"independently verified, unlike the Key ID or fingerprint. Only trust this "
"key if you've confirmed it yourself (e.g. from the distro's own official "
"website or keyserver listing)."
msgstr ""
"Nota: essa identidade é autodeclarada por quem criou a chave - NÃO é "
"verificada de forma independente, ao contrário do ID da chave ou da "
"impressão digital. Só confie nesta chave se a tiver confirmado pessoalmente "
"(por exemplo, no site oficial da distribuição ou num servidor de chaves)."

msgid ""
"This checksum-listing file's signing key isn't one this tool already "
"recognizes."
msgstr ""
"A chave de assinatura deste ficheiro de lista de somas de verificação não é "
"uma que esta ferramenta já reconheça."

msgid ""
"This signing key currently only lives in your personal keyring (pubring.kbx)."
msgstr ""
"Esta chave de assinatura atualmente só existe no seu chaveiro pessoal "
"(pubring.kbx)."

msgid ""
"Copy it into ~/.gnupg/trustedkeys.gpg so future checks don't depend on it "
"staying there?"
msgstr ""
"Copiá-la para ~/.gnupg/trustedkeys.gpg para que as futuras verificações não "
"dependam de ela lá permanecer?"

msgid "This signing key was just fetched from a keyserver."
msgstr ""
"Esta chave de assinatura acabou de ser obtida a partir de um servidor de "
"chaves."

msgid ""
"Remember it locally, in ~/.gnupg/trustedkeys.gpg, so future checks don't "
"need the network again?"
msgstr ""
"Guardá-la localmente, em ~/.gnupg/trustedkeys.gpg, para que as futuras "
"verificações não precisem novamente da rede?"

msgid "Keep this key"
msgstr "Manter esta chave"

msgid "No thanks"
msgstr "Não, obrigado"

msgid "key saved locally - future checks won't need the network"
msgstr ""
"chave guardada localmente - as futuras verificações não precisarão da rede"

msgid "used an already-cached key, no network needed"
msgstr "utilizada uma chave já em cache, sem necessidade de rede"

msgid "used a key from your personal keyring (pubring.kbx)"
msgstr "utilizada uma chave do seu chaveiro pessoal (pubring.kbx)"

msgid "fetched the signing key from a keyserver"
msgstr "obtida a chave de assinatura a partir de um servidor de chaves"

#. TRANSLATORS: ${KEY_EXPIRY_DATE_SAFE} is a date (e.g. 2026-08-06) - keep the placeholder as-is.
#, sh-format
msgid ""
"this key expired on ${KEY_EXPIRY_DATE_SAFE} - this does not affect the "
"signature check"
msgstr ""
"esta chave expirou em ${KEY_EXPIRY_DATE_SAFE} - isto não afeta a verificação "
"da assinatura"

msgid "this key has expired - this does not affect the signature check"
msgstr "esta chave expirou - isto não afeta a verificação da assinatura"

msgid "Verified OK"
msgstr "Verificação bem-sucedida"

msgid "Key not trusted"
msgstr "Chave não fidedigna"

msgid "Nothing to verify"
msgstr "Nada para verificar"

msgid "Verification FAILED"
msgstr "Verificação FALHADA"

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE}/${BTN_TRUST_THIS_KEY} are translated button labels - keep placeholders as-is.
#, sh-format
msgid ""
"The cryptographic check itself already came back GOOD (see the technical "
"details below) - you just haven't trusted this signing key yet. If you're "
"confident this is the genuine key (e.g. you've checked its fingerprint "
"against the distro's own official site or keyserver listing), click "
"\"${BTN_CHECK_ANOTHER_FILE}\" and choose \"${BTN_TRUST_THIS_KEY}\" this time."
msgstr ""
"A própria verificação criptográfica já tinha sido BOA (veja os detalhes "
"técnicos abaixo) - simplesmente ainda não confiou nesta chave de assinatura. "
"Se tiver a certeza de que é a chave genuína (por exemplo, verificou a sua "
"impressão digital no sítio oficial da distribuição ou num servidor de "
"chaves), clique em «${BTN_CHECK_ANOTHER_FILE}» e escolha desta vez "
"«${BTN_TRUST_THIS_KEY}»."

msgid ""
"The cryptographic check itself already came back GOOD (see the technical "
"details below) - the key just couldn't be saved for future trust (see the "
"technical details for why). Feel free to try again."
msgstr ""
"A própria verificação criptográfica já tinha sido BOA (veja os detalhes "
"técnicos abaixo) - a chave apenas não pôde ser guardada para confiança "
"futura (veja os detalhes técnicos para saber porquê). Sinta-se à vontade "
"para tentar novamente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid ""
"You pointed this tool at a checksum-listing file, not a single ISO - it can "
"cover many ISOs at once, so there's no one file to check unless exactly one "
"of the ones it mentions is actually present here (see the technical details "
"below for which). Use \"${BTN_CHECK_ANOTHER_FILE}\" and point at the "
"actual .iso file instead."
msgstr ""
"Apontou esta ferramenta para um ficheiro de lista de somas de verificação, "
"não para um único ISO - esse ficheiro pode cobrir vários ISO ao mesmo tempo, "
"pelo que não há um único ficheiro a verificar, a menos que exatamente um dos "
"que menciona esteja realmente presente aqui (veja os detalhes técnicos "
"abaixo para saber qual). Utilize «${BTN_CHECK_ANOTHER_FILE}» e aponte "
"diretamente para o ficheiro .iso real."

msgid ""
"No signature file or signed checksum listing was found for this ISO - "
"there's nothing here to check yet."
msgstr ""
"Não foi encontrado nenhum ficheiro de assinatura nem nenhuma lista de somas "
"de verificação assinada para esta ISO - ainda não há nada para verificar "
"aqui."

#. TRANSLATORS: ${CHECKSUM_FILE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid ""
"This checksum listing (${CHECKSUM_FILE_SAFE}) has no signature file of its "
"own (.sig/.asc/.gpg/.sign) next to it - it can't be trusted without one, so "
"it was never checked against this ISO."
msgstr ""
"Esta lista de somas de verificação (${CHECKSUM_FILE_SAFE}) não tem um "
"ficheiro de assinatura próprio (.sig/.asc/.gpg/.sign) ao seu lado - sem ele "
"não é possível confiar nela, por isso nunca foi verificada em relação a esta "
"ISO."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#, sh-format
msgid ""
"This is a signature file, but its ISO ('${DISPLAY_ISO_SAFE}') isn't in the "
"same folder - this tool only looks for a counterpart next to the file you "
"pick."
msgstr ""
"Este é um ficheiro de assinatura, mas a sua ISO ('${DISPLAY_ISO_SAFE}') não "
"está na mesma pasta - esta ferramenta só procura o correspondente ao lado do "
"ficheiro que escolher."

#. TRANSLATORS: ${LISTING_BASE_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid ""
"This is a signature file for a checksum listing, but '${LISTING_BASE_SAFE}' "
"isn't in the same folder - this tool only looks for a counterpart next to "
"the file you pick."
msgstr ""
"Este é um ficheiro de assinatura de uma lista de somas de verificação, mas "
"'${LISTING_BASE_SAFE}' não está na mesma pasta - esta ferramenta só procura "
"o correspondente ao lado do ficheiro que escolher."

#. TRANSLATORS: ${DISPLAY_ISO_SAFE} is the ISO's filename - keep the placeholder as-is.
#, sh-format
msgid ""
"Neither '${DISPLAY_ISO_SAFE}' nor a signature file for it were found in this "
"folder - nothing to check yet."
msgstr ""
"Não foi encontrado nem o ficheiro '${DISPLAY_ISO_SAFE}' nem um ficheiro de "
"assinatura para ele nesta pasta - ainda não há nada para verificar."

msgid ""
"This checksum file isn't signed, and the ISO it describes has no signature "
"of its own either - there's nothing here this tool can cryptographically "
"verify. Check whether the distro provides a signed checksum listing or a "
"direct .sig/.asc/.gpg file for this ISO."
msgstr ""
"Este ficheiro de somas de verificação não está assinado, e o ISO que "
"descreve também não tem assinatura própria - não há aqui nada que esta "
"ferramenta possa verificar criptograficamente. Verifique se a distribuição "
"fornece uma lista de somas de verificação assinada ou um "
"ficheiro .sig/.asc/.gpg direto para este ISO."

msgid ""
"The checksum file that lists this ISO's hash failed its own verification "
"(bad/untrusted signature, or its key couldn't be confirmed) - nothing in it "
"can be trusted. Re-download the checksum/signature files (and probably the "
"ISO too), ideally from a different mirror."
msgstr ""
"O ficheiro de somas de verificação que lista o hash deste ISO falhou a sua "
"própria verificação (assinatura inválida/não fiável, ou não foi possível "
"confirmar a sua chave) - nada nele é de confiança. Volte a transferir os "
"ficheiros de soma de verificação/assinatura (e provavelmente também o ISO), "
"de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${CHECKSUM_INFO_SAFE} is the checksum-listing file's name - keep the placeholder as-is.
#, sh-format
msgid ""
"This ISO was checked against a signed checksum listing "
"(${CHECKSUM_INFO_SAFE}) that IS validly signed - but the ISO's own hash "
"doesn't match what's listed. The checksum list itself is trustworthy; this "
"particular download is not. Re-download the ISO, ideally from a different "
"mirror."
msgstr ""
"Este ISO foi verificado com base numa lista de somas de verificação assinada "
"(${CHECKSUM_INFO_SAFE}) que ESTÁ validamente assinada - mas o próprio hash "
"do ISO não corresponde ao que está listado. A lista de somas de verificação "
"em si é de confiança; esta transferência em particular não é. Volte a "
"transferir o ISO, de preferência a partir de um servidor espelho diferente."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid ""
"No direct signature file was found for this ISO, and none of the checksum-"
"listing files found nearby mention this exact ISO filename either. If this "
"distro uses a different naming convention, use \"${BTN_CHECK_ANOTHER_FILE}\" "
"and point at the right file directly."
msgstr ""
"Não foi encontrado nenhum ficheiro de assinatura direto para este ISO, e "
"nenhum dos ficheiros de lista de somas de verificação encontrados nas "
"proximidades menciona também este nome exato de ficheiro ISO. Se esta "
"distribuição utilizar uma convenção de nomenclatura diferente, utilize "
"«${BTN_CHECK_ANOTHER_FILE}» e aponte diretamente para o ficheiro correto."

#. TRANSLATORS: ${BTN_CHECK_ANOTHER_FILE} is a translated button label - keep the placeholder as-is.
#, sh-format
msgid ""
"This signature file's name doesn't match this ISO's name, so it likely "
"belongs to a different download. Use \"${BTN_CHECK_ANOTHER_FILE}\" and pick "
"just this ISO, or just its own real signature file - the tool finds the "
"matching one automatically."
msgstr ""
"O nome deste ficheiro de assinatura não corresponde ao nome desta ISO, pelo "
"que provavelmente pertence a uma transferência diferente. Utilize "
"«${BTN_CHECK_ANOTHER_FILE}» e escolha apenas esta ISO, ou apenas o seu "
"próprio ficheiro de assinatura real - a ferramenta encontra automaticamente "
"o ficheiro correspondente."

msgid ""
"On top of the signature not matching, this signing key also isn't one this "
"tool already recognizes - treat this file as untrustworthy and re-download "
"from an official source."
msgstr ""
"Além de a assinatura não corresponder, esta chave de assinatura também não é "
"uma que esta ferramenta já reconheça - trate este ficheiro como não fiável e "
"volte a transferi-lo a partir de uma fonte oficial."

msgid ""
"The ISO may be corrupted, or the download was incomplete or tampered with - "
"try re-downloading it, ideally from a different mirror."
msgstr ""
"O ISO pode estar corrompido, ou a transferência ficou incompleta ou foi "
"adulterada - tente transferi-lo novamente, de preferência a partir de um "
"servidor espelho diferente."

msgid "Usage:"
msgstr "Utilização:"

#. TRANSLATORS: keep the distro names (Debian, Ubuntu, Linux Mint) exactly as-is.
msgid ""
"Verify the GPG signature of an ISO image (any distro - built-in recognition "
"of the documented MX Linux/antiX signing keys, plus a checksum-listing "
"convention for distros that sign a checksum listing instead of the ISO "
"directly, e.g. Debian, Ubuntu, Linux Mint)."
msgstr ""
"Verifica a assinatura GPG de uma imagem ISO (qualquer distribuição - com "
"reconhecimento integrado das chaves de assinatura documentadas do MX Linux/"
"antiX, bem como uma convenção de lista de somas de verificação para "
"distribuições que assinam uma lista de somas de verificação em vez do "
"próprio ISO, por exemplo, Debian, Ubuntu, Linux Mint)."

msgid "this help"
msgstr "esta ajuda"

msgid "show version and exit"
msgstr "mostra a versão e sai"

msgid ""
"full manual: every option, recognition rules, the checksum-listing "
"convention, and more"
msgstr ""
"manual completo: todas as opções, regras de reconhecimento, a convenção de "
"lista de somas de verificação e mais"

msgid "verify once even if the key isn't recognized"
msgstr "verifica uma vez mesmo que a chave não seja reconhecida"

#. TRANSLATORS: ${FLAG_ALLOW_UNKNOWN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "like ${FLAG_ALLOW_UNKNOWN}, and remembers the key too"
msgstr "como ${FLAG_ALLOW_UNKNOWN}, mas também memoriza a chave"

msgid "list this tool's built-in recognized signing keys"
msgstr ""
"listar as chaves de assinatura incorporadas que esta ferramenta reconhece"

msgid "list every key saved in trustedkeys.gpg"
msgstr "lista todas as chaves guardadas em trustedkeys.gpg"

#. TRANSLATORS: ${FLAG_MAN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "For every other option (scripting/automation flags) see ${FLAG_MAN}."
msgstr ""
"Para qualquer outra opção (opções de script/automação) consulte ${FLAG_MAN}."

msgid "could not generate the man page (pandoc failed)"
msgstr "não foi possível gerar a página do manual (o pandoc falhou)"

#. TRANSLATORS: ${man_src} is a file path, ${FLAG_MAN} a literal flag name.
#, sh-format
msgid ""
"man page not built yet and pandoc isn't installed - see ${man_src} directly, "
"or install pandoc and re-run ${FLAG_MAN}"
msgstr ""
"a página do manual ainda não foi gerada e o pandoc não está instalado - "
"consulte diretamente ${man_src}, ou instale o pandoc e execute novamente "
"${FLAG_MAN}"

msgid "warning:"
msgstr "aviso:"

msgid "info:"
msgstr "info:"

msgid "error:"
msgstr "erro:"

#. TRANSLATORS: ${flag}/${FLAG_MAN} are literal names - keep placeholders as-is.
#, sh-format
msgid "${flag} requires a value (see ${FLAG_MAN})"
msgstr "${flag} requer um valor (consulte ${FLAG_MAN})"

msgid "Manage trusted keys from the command line:"
msgstr "Faça a gestão das chaves de confiança a partir da linha de comandos:"

#. TRANSLATORS: ${ENV_DISPLAY}/${ENV_WAYLAND_DISPLAY} are literal env-var names - keep placeholders as-is.
#, sh-format
msgid ""
"no graphical session detected (neither ${ENV_DISPLAY} nor "
"${ENV_WAYLAND_DISPLAY} is set) - the trusted-keys manager needs a desktop to "
"show its window."
msgstr ""
"nenhuma sessão gráfica detetada (nem ${ENV_DISPLAY} nem "
"${ENV_WAYLAND_DISPLAY} está definida) - o gestor de chaves de confiança "
"precisa de um ambiente gráfico para mostrar a sua janela."

msgid "Manage trusted keys from the command line instead:"
msgstr "Faça a gestão das chaves de confiança a partir da linha de comandos:"

msgid "remove <fpr> from trustedkeys.gpg"
msgstr "remove <fpr> de trustedkeys.gpg"

msgid "export trusted key(s) to <path> (all if none given)"
msgstr ""
"exporta a(s) chave(s) de confiança para <path> (todas se nenhuma for "
"indicada)"

msgid "list the key(s) in an external key file, read-only"
msgstr "lista a(s) chave(s) num ficheiro de chave externo, apenas leitura"

msgid "import key(s) from an external key file (all if none given)"
msgstr ""
"importa chave(s) de um ficheiro de chave externo (todas se nenhuma for "
"indicada)"

#. TRANSLATORS: ${CMD_MAN} is a literal command - keep the placeholder as-is.
#, sh-format
msgid "See '${CMD_MAN}' for the full manual."
msgstr "Consulte '${CMD_MAN}' para o manual completo."

#. TRANSLATORS: ${FLAG_MAN} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid ""
"verify-iso-sig - opens a window to pick and check an ISO or signature file "
"by default when a graphical session is available; falls back to the plain "
"command-line tool otherwise. This preamble covers this launcher's own "
"behavior; a short command-line reference (used automatically whenever given "
"arguments don't look like that window's own syntax, or no graphical session "
"is available) follows below it - see ${FLAG_MAN} for the complete one."
msgstr ""
"verify-iso-sig abre por predefinição uma janela para escolher e verificar um "
"ficheiro ISO ou de assinatura quando existe uma sessão gráfica disponível; "
"caso contrário, recorre à ferramenta de linha de comandos. Esta introdução "
"cobre o comportamento deste lançador; segue-se uma breve referência de linha "
"de comandos (usada automaticamente sempre que os argumentos indicados não se "
"pareçam com a sintaxe dessa janela, ou não exista sessão gráfica disponível) "
"- consulte ${FLAG_MAN} para a referência completa."

msgid ""
"open that window if a display is available (default), otherwise this same "
"help"
msgstr ""
"abre essa janela se existir um ecrã disponível (predefinição), caso "
"contrário esta mesma ajuda"

msgid "(default) the graphical main program"
msgstr "(predefinição) o programa gráfico principal"

msgid "plain command-line mode"
msgstr "modo de linha de comandos"

#. TRANSLATORS: ${FLAG_HELP} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid ""
"trusted-keys manager GUI (add ${FLAG_HELP} for its own flags), or with no "
"display, print the CLI flags that cover the same ground"
msgstr ""
"interface gráfica do gestor de chaves de confiança (adicione ${FLAG_HELP} "
"para as suas próprias opções), ou sem ecrã, imprime as opções da CLI que "
"cobrem o mesmo"

#. TRANSLATORS: ${FLAG_GUI} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid ""
"same as ${FLAG_GUI}, but also shows the drag-and-drop pane (most users won't "
"need this - reachable from the app menu's own \"Drag & Drop\" entry)"
msgstr ""
"igual a ${FLAG_GUI}, mas também mostra o painel de arrastar e soltar (a "
"maioria dos utilizadores não precisa disto - acessível a partir da entrada "
"«Arrastar e Soltar» do menu da aplicação)"

#. TRANSLATORS: ${FLAG_CHECKSUM_ALGO}/${algo} are literal - keep placeholders as-is.
#, sh-format
msgid ""
"unknown ${FLAG_CHECKSUM_ALGO} '${algo}' (expected sha256, sha512, sha1, or "
"md5)"
msgstr ""
"${FLAG_CHECKSUM_ALGO} '${algo}' desconhecido (esperado sha256, sha512, sha1, "
"ou md5)"

#. TRANSLATORS: ${opt}/${FLAG_MAN} are literal - keep placeholders as-is.
#, sh-format
msgid "unknown option '${opt}' (see ${FLAG_MAN})"
msgstr "opção '${opt}' desconhecida (consulte ${FLAG_MAN})"

#. TRANSLATORS: ${FLAG_KEEP_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid "exactly one fingerprint argument is required for ${FLAG_KEEP_KEY}"
msgstr ""
"é necessário exatamente um argumento de impressão digital para "
"${FLAG_KEEP_KEY}"

#. TRANSLATORS: ${FLAG_KEEP_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid ""
"${FLAG_KEEP_KEY} needs a full 40-character (or 64-character) hex "
"fingerprint, not '${FPR}'"
msgstr ""
"${FLAG_KEEP_KEY} exige uma impressão digital hexadecimal completa de 40 "
"caracteres (ou 64 caracteres), não '${FPR}'"

msgid "this option takes no extra arguments"
msgstr "esta opção não aceita argumentos adicionais"

msgid "expected an ISO or signature file to check"
msgstr "esperava-se um ficheiro ISO ou de assinatura para verificar"

#, sh-format
msgid ""
"'${ISO}' is a directory, not a file - point this at the actual .iso file (or "
"its .sig/.asc/.gpg/.sign signature file) directly."
msgstr ""
"'${ISO}' é uma pasta, não um ficheiro - aponte diretamente para o "
"ficheiro .iso real (ou para o seu ficheiro de "
"assinatura .sig/.asc/.gpg/.sign)."

#, sh-format
msgid ""
"'${SIG}' is a directory, not a file - point this at the actual signature "
"file directly."
msgstr ""
"'${SIG}' é uma pasta, não um ficheiro - aponte diretamente para o ficheiro "
"de assinatura real."

#, sh-format
msgid ""
"this key expired on ${date_str} - this does not affect the signature check"
msgstr ""
"esta chave expirou em ${date_str} - isto não afeta a verificação da "
"assinatura"

msgid "this key's expiry was renewed - updated local copy automatically"
msgstr ""
"a validade desta chave foi renovada - cópia local atualizada automaticamente"

#, sh-format
msgid "checking ${ks} for a renewed copy of this key..."
msgstr "a verificar ${ks} em busca de uma cópia renovada desta chave..."

msgid "no renewal found - continuing with the existing (expired) key"
msgstr ""
"não foi encontrada nenhuma renovação - a continuar com a chave existente "
"(expirada)"

#, sh-format
msgid "'${UNTRUST_KEY}' is not in ${TRUSTED_GPG}"
msgstr "'${UNTRUST_KEY}' não está em ${TRUSTED_GPG}"

#, sh-format
msgid "removed ${UNTRUST_KEY} from ${TRUSTED_GPG}"
msgstr "removida ${UNTRUST_KEY} de ${TRUSTED_GPG}"

#, sh-format
msgid "could not remove '${UNTRUST_KEY}' from ${TRUSTED_GPG}: ${out}"
msgstr "não foi possível remover '${UNTRUST_KEY}' de ${TRUSTED_GPG}: ${out}"

#, sh-format
msgid "no trusted keys saved yet (${TRUSTED_GPG} doesn't exist)"
msgstr "ainda não há chaves de confiança guardadas (${TRUSTED_GPG} não existe)"

#, sh-format
msgid "warning: fingerprint '${fpr}' not found in ${TRUSTED_GPG}, skipping"
msgstr ""
"aviso: impressão digital '${fpr}' não encontrada em ${TRUSTED_GPG}, a ignorar"

#, sh-format
msgid "note: '${fpr}' is a subkey - resolved to its primary key '${resolved}'"
msgstr ""
"nota: '${fpr}' é uma subchave - resolvida para a sua chave primária "
"'${resolved}'"

msgid "no matching trusted key(s) to export"
msgstr "nenhuma chave de confiança correspondente para exportar"

#, sh-format
msgid "could not export to '${EXPORT_TRUSTED_KEYS}': ${ERR}"
msgstr "não foi possível exportar para '${EXPORT_TRUSTED_KEYS}': ${ERR}"

#, sh-format
msgid "exported ${EXPORTED_COUNT} key(s) to ${EXPORT_TRUSTED_KEYS}"
msgstr "${EXPORTED_COUNT} chave(s) exportada(s) para ${EXPORT_TRUSTED_KEYS}"

#, sh-format
msgid "cannot read '${INSPECT_KEY_FILE}'"
msgstr "não é possível ler '${INSPECT_KEY_FILE}'"

#, sh-format
msgid ""
"'${INSPECT_KEY_FILE}' does not look like a valid OpenPGP key file: "
"${SHOW_OUT}"
msgstr ""
"'${INSPECT_KEY_FILE}' não parece ser um ficheiro de chave OpenPGP válido: "
"${SHOW_OUT}"

#, sh-format
msgid ""
"'${INSPECT_KEY_FILE}' contains private/secret key material - refusing to "
"treat it as a public trusted-signing key"
msgstr ""
"'${INSPECT_KEY_FILE}' contém material de chave privada/secreta - a recusar "
"tratá-lo como uma chave pública de assinatura de confiança"

#, sh-format
msgid "warning: could not export key from ${ring}: ${out}"
msgstr "aviso: não foi possível exportar a chave de ${ring}: ${out}"

#, sh-format
msgid "cannot read '${IMPORT_TRUSTED_KEYS}'"
msgstr "não é possível ler '${IMPORT_TRUSTED_KEYS}'"

#, sh-format
msgid ""
"'${IMPORT_TRUSTED_KEYS}' does not look like a valid OpenPGP key file: "
"${SHOW_OUT}"
msgstr ""
"'${IMPORT_TRUSTED_KEYS}' não parece ser um ficheiro de chave OpenPGP válido: "
"${SHOW_OUT}"

#, sh-format
msgid ""
"'${IMPORT_TRUSTED_KEYS}' contains private/secret key material - refusing to "
"import it as a public trusted-signing key"
msgstr ""
"'${IMPORT_TRUSTED_KEYS}' contém material de chave privada/secreta - a "
"recusar importá-lo como uma chave pública de assinatura de confiança"

#, sh-format
msgid "no OpenPGP keys found in '${IMPORT_TRUSTED_KEYS}'"
msgstr "não foram encontradas chaves OpenPGP em '${IMPORT_TRUSTED_KEYS}'"

#, sh-format
msgid "could not import '${IMPORT_TRUSTED_KEYS}' into a scratch keyring"
msgstr ""
"não foi possível importar '${IMPORT_TRUSTED_KEYS}' para um chaveiro "
"temporário"

#, sh-format
msgid ""
"warning: fingerprint '${fpr}' not found in '${IMPORT_TRUSTED_KEYS}', skipping"
msgstr ""
"aviso: impressão digital '${fpr}' não encontrada em "
"'${IMPORT_TRUSTED_KEYS}', a ignorar"

msgid "no matching key(s) to import"
msgstr "nenhuma chave correspondente para importar"

#, sh-format
msgid "warning: could not import '${FPR}' into ${TRUSTED_GPG}"
msgstr "aviso: não foi possível importar '${FPR}' para ${TRUSTED_GPG}"

#, sh-format
msgid "no key(s) were actually imported into ${TRUSTED_GPG}"
msgstr "nenhuma chave foi efetivamente importada para ${TRUSTED_GPG}"

#. TRANSLATORS: this exact line is also parsed by the GUI's own
#. --status-fd tag right after it (IMPORT_SUMMARY, never localized) -
#. translate freely, the numbers/word order can differ per language,
#. only this line's own display text changes.
#, sh-format
msgid ""
"${PROCESSED} key(s) processed: ${IMPORTED} new, ${CHANGED} updated, "
"${UNCHANGED_COUNT} unchanged"
msgstr ""
"${PROCESSED} chave(s) processada(s): ${IMPORTED} nova(s), ${CHANGED} "
"atualizada(s), ${UNCHANGED_COUNT} inalterada(s)"

#, sh-format
msgid ""
"neither '${candidate_base}' nor a signature file for it were found in this "
"folder - nothing to check yet."
msgstr ""
"não foi encontrado nem o ficheiro '${candidate_base}' nem um ficheiro de "
"assinatura para ele nesta pasta - ainda não há nada para verificar."

#, sh-format
msgid "resolved ISO: ${resolved_base}"
msgstr "ISO resolvido: ${resolved_base}"

#, sh-format
msgid ""
"'${iso_base}' is an unsigned per-file checksum - not used for verification. "
"Using '${candidate_sig_base}' instead, the ISO's own direct signature."
msgstr ""
"'${iso_base}' é uma soma de verificação por ficheiro não assinada - não é "
"usada para verificação. A usar '${candidate_sig_base}' em vez disso, a "
"assinatura direta do próprio ISO."

#, sh-format
msgid ""
"'${iso_base}' is an unsigned checksum file, and '${candidate_base}' has no "
"direct .sig/.asc/.gpg/.sign of its own either - nothing here can be "
"cryptographically verified."
msgstr ""
"'${iso_base}' é um ficheiro de somas de verificação não assinado, e "
"'${candidate_base}' também não tem um .sig/.asc/.gpg/.sign direto próprio - "
"nada aqui pode ser verificado criptograficamente."

#, sh-format
msgid ""
"this is a signature file for a checksum listing, but '${iso_base}' isn't in "
"the same folder"
msgstr ""
"este é um ficheiro de assinatura de uma lista de somas de verificação, mas "
"'${iso_base}' não está na mesma pasta"

#, sh-format
msgid "cannot read checksum listing '${iso_base}'"
msgstr "não é possível ler a lista de somas de verificação '${iso_base}'"

#, sh-format
msgid "using checksum file: ${iso_base} (${algo})"
msgstr "a usar o ficheiro de somas de verificação: ${iso_base} (${algo})"

#, sh-format
msgid "checksum file signature: ${sigfile_base}"
msgstr "assinatura do ficheiro de somas de verificação: ${sigfile_base}"

#, sh-format
msgid ""
"'${iso_base}' is a checksum listing (it can cover many ISOs), not a single "
"ISO to verify directly - none of the .iso files it mentions are present in "
"'${dir}'. Point this tool at the actual .iso file instead (its checksum/"
"signature will be found and checked automatically)."
msgstr ""
"'${iso_base}' é uma lista de somas de verificação (pode cobrir vários ISO), "
"e não um único ISO a verificar diretamente - nenhum dos ficheiros .iso que "
"menciona está presente em '${dir}'. Aponte esta ferramenta para o "
"ficheiro .iso real (a sua soma de verificação/assinatura será encontrada e "
"verificada automaticamente)."

#, sh-format
msgid ""
"'${iso_base}' is a checksum listing covering multiple ISOs present in "
"'${dir}': ${candidates_joined} - point this tool at the specific .iso file "
"you want to check instead."
msgstr ""
"'${iso_base}' é uma lista de somas de verificação que cobre vários ISO "
"presentes em '${dir}': ${candidates_joined} - aponte esta ferramenta "
"diretamente para o ficheiro .iso específico que deseja verificar."

#. TRANSLATORS: ${FLAG_CHECKSUM_ALGO}/${FLAG_CHECKSUM_FILE} are literal flag names - keep placeholders as-is.
#, sh-format
msgid ""
"${FLAG_CHECKSUM_ALGO} is required when ${FLAG_CHECKSUM_FILE} names a file "
"not in the built-in list (SHA512SUMS, SHA256SUMS, sha256sum.txt, ...)"
msgstr ""
"${FLAG_CHECKSUM_ALGO} é obrigatório quando ${FLAG_CHECKSUM_FILE} indica um "
"ficheiro que não está na lista incorporada (SHA512SUMS, SHA256SUMS, "
"sha256sum.txt, ...)"

#, sh-format
msgid ""
"the checksum file '${name_base}' failed its own signature check - it cannot "
"be trusted, so the ISO hash inside it cannot be trusted either. Re-download "
"the ISO and the checksum/signature files, ideally from a different mirror."
msgstr ""
"o ficheiro de somas de verificação '${name_base}' falhou a sua própria "
"verificação de assinatura - não é de confiança, pelo que o hash do ISO nele "
"contido também não é de confiança. Volte a transferir o ISO e os ficheiros "
"de soma de verificação/assinatura, de preferência a partir de um servidor "
"espelho diferente."

#, sh-format
msgid ""
"checksum file '${name_base}' uses an unsupported hash algorithm "
"('${hashcmd}' not found)"
msgstr ""
"o ficheiro de somas de verificação '${name_base}' usa um algoritmo de hash "
"não suportado ('${hashcmd}' não encontrado)"

#, sh-format
msgid "using checksum file: ${name_base} (${algo})"
msgstr "a usar o ficheiro de somas de verificação: ${name_base} (${algo})"

#, sh-format
msgid ""
"'${name_base}' is validly signed, but '${base}' does not match the recorded "
"${algo} checksum - this download is likely corrupted, incomplete, or was "
"tampered with after the checksum file was signed. Re-download the ISO, "
"ideally from a different mirror. (The checksum/signature files themselves "
"are fine - no need to re-fetch those.)"
msgstr ""
"'${name_base}' está validamente assinado, mas '${base}' não corresponde à "
"soma de verificação ${algo} registada - esta transferência está "
"provavelmente corrompida, incompleta, ou foi adulterada depois de o ficheiro "
"de somas de verificação ter sido assinado. Volte a transferir o ISO, de "
"preferência a partir de um servidor espelho diferente. (Os próprios "
"ficheiros de soma de verificação/assinatura estão corretos - não é "
"necessário voltar a obtê-los.)"

msgid "OK - signature and checksum both verified"
msgstr "OK - assinatura e soma de verificação ambas verificadas"

#, sh-format
msgid ""
"no signature file (.sig/.asc/.gpg/.sign) was found for '${override_base}' - "
"cannot verify it without one"
msgstr ""
"não foi encontrado nenhum ficheiro de assinatura (.sig/.asc/.gpg/.sign) para "
"'${override_base}' - não é possível verificá-lo sem um"

#, sh-format
msgid "'${base}' is not listed in '${CHECKSUM_FILE_OVERRIDE}'"
msgstr "'${base}' não está listado em '${CHECKSUM_FILE_OVERRIDE}'"

#, sh-format
msgid ""
"no signature file found for '${base}', and none of the checksum-listing "
"files in its directory (${tried_joined}) contain an entry for it either"
msgstr ""
"não foi encontrado nenhum ficheiro de assinatura para '${base}', e nenhum "
"dos ficheiros de lista de somas de verificação na sua pasta "
"(${tried_joined}) contém uma entrada para ele"

#, sh-format
msgid "no signature file or checksum listing was found for '${base}'"
msgstr ""
"não foi encontrado nenhum ficheiro de assinatura nem nenhuma lista de somas "
"de verificação para '${base}'"

#, sh-format
msgid "cannot read ISO file '${ISO}'"
msgstr "não é possível ler o ficheiro ISO '${ISO}'"

#, sh-format
msgid "cannot read signature file '${SIG}'"
msgstr "não é possível ler o ficheiro de assinatura '${SIG}'"

msgid "gpgv not found"
msgstr "gpgv não encontrado"

msgid "gpg not found"
msgstr "gpg não encontrado"

#, sh-format
msgid "could not extract signing key fingerprint from '${ISO}'"
msgstr ""
"não foi possível extrair a impressão digital da chave de assinatura de "
"'${ISO}'"

#, sh-format
msgid "could not extract signing key fingerprint from '${SIG}'"
msgstr ""
"não foi possível extrair a impressão digital da chave de assinatura de "
"'${SIG}'"

#, sh-format
msgid "signature made with: ${FPR}"
msgstr "assinatura feita com: ${FPR}"

#, sh-format
msgid "recognized signing key: ${label}"
msgstr "chave de assinatura reconhecida: ${label}"

#, sh-format
msgid "recognized: key already cached and trusted in ${TRUSTED_GPG}"
msgstr "reconhecida: chave já em cache e de confiança em ${TRUSTED_GPG}"

#, sh-format
msgid ""
"recognized: key already present in ${PUBRING_KBX} and explicitly marked "
"trusted there"
msgstr ""
"reconhecida: chave já presente em ${PUBRING_KBX} e explicitamente marcada "
"como de confiança aí"

#, sh-format
msgid ""
"kept ${FPR} in ${TRUSTED_GPG} - future runs will recognize it automatically"
msgstr ""
"mantida ${FPR} em ${TRUSTED_GPG} - as futuras execuções irão reconhecê-la "
"automaticamente"

#, sh-format
msgid "warning: could not save key into ${TRUSTED_GPG}: ${out}"
msgstr "aviso: não foi possível guardar a chave em ${TRUSTED_GPG}: ${out}"

#, sh-format
msgid ""
"${FPR} is not one of this tool's built-in recognized keys - verify its "
"fingerprint independently before trusting it (e.g. against the distro's own "
"official website or keyserver listing)"
msgstr ""
"${FPR} não é uma das chaves incorporadas que esta ferramenta já reconhece - "
"verifique a sua impressão digital de forma independente antes de confiar "
"nela (por exemplo, no sítio oficial da distribuição ou num servidor de "
"chaves)"

#. TRANSLATORS: ${FLAG_ALLOW_UNKNOWN}/${FLAG_TRUST_KEY} are literal flag names - keep placeholders as-is.
#, sh-format
msgid ""
"refusing to verify against an unrecognized signing key (pass "
"${FLAG_ALLOW_UNKNOWN} to verify just this once, or ${FLAG_TRUST_KEY} to also "
"remember it for next time)"
msgstr ""
"a recusar verificar com uma chave de assinatura não reconhecida (indique "
"${FLAG_ALLOW_UNKNOWN} para verificar apenas desta vez, ou ${FLAG_TRUST_KEY} "
"para também a memorizar para a próxima vez)"

#. TRANSLATORS: ${FLAG_TRUST_KEY} is a literal flag name - keep the placeholder as-is.
#, sh-format
msgid ""
"verifying anyway - if the result below is GOOD and you decide you trust this "
"key, use ${FLAG_TRUST_KEY} next time (or mark it trusted in your own GPG "
"keyring) so future checks recognize it automatically"
msgstr ""
"a verificar de qualquer forma - se o resultado abaixo for BOA e decidir "
"confiar nesta chave, utilize ${FLAG_TRUST_KEY} da próxima vez (ou marque-a "
"como de confiança no seu próprio chaveiro GPG) para que as futuras "
"verificações a reconheçam automaticamente"

#, sh-format
msgid ""
"kept ${FPR} in ${TRUSTED_GPG} (reused the copy fetched during verification - "
"no extra keyserver lookup needed)"
msgstr ""
"mantida ${FPR} em ${TRUSTED_GPG} (reutilizada a cópia obtida durante a "
"verificação - sem necessidade de consulta adicional ao servidor de chaves)"

#, sh-format
msgid "key already present and valid in ${TRUSTED_GPG}"
