msgstr ""
"Project-Id-Version: verify-iso-sig\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-08-30 23:06+0200\n"
"PO-Revision-Date: 2026-07-30 23:30+0200\n"
"Last-Translator: \n"
"Language-Team: Brazilian Portuguese\n"
