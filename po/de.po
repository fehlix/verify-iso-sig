"einem anderen Mirror."

#: verify-iso-sig:1771
#, sh-format
msgid ""
"checksum file '${name_base}' uses an unsupported hash algorithm "
"('${hashcmd}' not found)"
msgstr "Prüfsummen-Datei '${name_base}' verwendet einen nicht unterstützten Hash-Algorithmus ('${hashcmd}' nicht gefunden)"

#: verify-iso-sig:1774 verify-iso-sig:1816
#, sh-format
msgid "using checksum file: ${name_base} (${algo})"
msgstr "verwendete Prüfsummen-Datei: ${name_base} (${algo})"

#: verify-iso-sig:1793 verify-iso-sig:1878
#, sh-format
msgid ""
"'${name_base}' is validly signed, but '${base}' does not match the recorded "
"${algo} checksum - this download is likely corrupted, incomplete, or was "
"tampered with after the checksum file was signed. Re-download the ISO, "
"ideally from a different mirror. (The checksum/signature files themselves "
"are fine - no need to re-fetch those.)"
msgstr ""
"'${name_base}' ist gültig signiert, aber '${base}' stimmt nicht mit der "
"erfassten ${algo}-Prüfsumme überein - dieser Download ist wahrscheinlich "
"beschädigt, unvollständig oder wurde nach der Signierung der Prüfsummen-"
"Datei manipuliert. Laden Sie die ISO erneut herunter, idealerweise von einem "
"anderen Mirror. (Die Prüfsummen-/Signaturdateien selbst sind in Ordnung - "
"diese müssen nicht erneut heruntergeladen werden.)"

#: verify-iso-sig:1796 verify-iso-sig:1881
msgid "OK - signature and checksum both verified"
msgstr "OK - Signatur und Prüfsumme beide verifiziert"

